export struct QueueItem {
    // `source` is the index in the real queue. A search hides rows without renumbering them.
    source: int,
    number: string,
    title: string,
    meta: string,
    duration: string,
    current: bool,
}

export struct AlbumItem {
    id: string,
    title: string,
    artist: string,
    starred: bool,
}

export struct CatalogHit {
    title: string,
    artist: string,
    detail: string,
    action: string,
}

export struct ArtistItem {
    id: string,
    name: string,
    current: bool,
}

export struct HomeRow {
    kind: string,
    title: string,
    detail: string,
    accent: bool,
}
