export struct QueueItem {
    // Stable index in the source queue or album, independent of filtering and sections.
    source: int,
    number: string,
    title: string,
    meta: string,
    playback-error: string,
    duration: string,
    current: bool,
    liked: bool,
    song-id: string,
    identified: bool,
    can-move-next: bool,
    can-move-end: bool,
}

export struct AlbumSections {
    library: [QueueItem],
    external: [QueueItem],
    external-note: string,
}

export struct AlbumItem {
    id: string,
    title: string,
    artist: string,
    starred: bool,
    cover: image,
    has-cover: bool,
}

export struct CatalogHit {
    section: string,
    is-album: bool,
    title: string,
    artist: string,
    detail: string,
    availability: string,
    can-check-source: bool,
    action: string,
    download-action: string,
    can-download: bool,
    song-id: string,
}

export struct ArtistItem {
    id: string,
    name: string,
    current: bool,
}

export struct HomeRow {
    source: int,
    cover: image,
    has-cover: bool,
    kind: string,
    title: string,
    detail: string,
    accent: bool,
    album-id: string,
    song-id: string,
}

export struct HomeSection {
    title: string,
    newest: bool,
    items: [HomeRow],
}
