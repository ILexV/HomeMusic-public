import { ComboBox, LineEdit } from "std-widgets.slint";
import { TrackList, TrackMenu } from "item-menus.slint";
import { CatalogHit, QueueItem } from "types.slint";

export global Theme {
    out property <color> bg: #1b1b1b;
    out property <color> panel: #242424;
    out property <color> raised: #2c2c2c;
    out property <color> line: #333333;
    out property <color> orange: #e8872a;
    out property <color> text: #f3f3f3;
    out property <color> muted: #a3a3a3;
    out property <color> dim: #8a8a8a;
}

export enum VisualizationMode { cover, stereo, spectrum, scope, waterfall }


export component Glyph inherits Rectangle {
    in property <string> kind;
    in property <color> tint: Theme.text;
    width: 16px;
    height: 16px;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    if root.kind == "play" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 5 2 L 14 8 L 5 14 Z";
        fill: root.tint;
    }
    if root.kind == "pause" : Rectangle {
        x: 3px;
        y: 2px;
        width: 3px;
        height: 12px;
        background: root.tint;
    }
    if root.kind == "pause" : Rectangle {
        x: 10px;
        y: 2px;
        width: 3px;
        height: 12px;
        background: root.tint;
    }
    if root.kind == "stop" : Rectangle {
        x: 3px;
        y: 3px;
        width: 10px;
        height: 10px;
        background: root.tint;
    }
    if root.kind == "prev" : Rectangle {
        x: 2px;
        y: 2px;
        width: 2px;
        height: 12px;
        background: root.tint;
    }
    if root.kind == "prev" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 14 2 L 6 8 L 14 14 Z";
        fill: root.tint;
    }
    if root.kind == "next" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 2 2 L 10 8 L 2 14 Z";
        fill: root.tint;
    }
    if root.kind == "next" : Rectangle {
        x: 12px;
        y: 2px;
        width: 2px;
        height: 12px;
        background: root.tint;
    }
    if root.kind == "play-next" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 2 2 L 4 2 L 4 9 L 10 9 L 10 6 L 15 10 L 10 14 L 10 11 L 2 11 Z";
        fill: root.tint;
    }
    if root.kind == "speaker" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M1 6 H4 L8 2.5 V13.5 L4 10 H1 Z";
        fill: root.tint;
    }
    if root.kind == "speaker" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M10.5 5.5 C12 6.8 12 9.2 10.5 10.5 M12.5 3 C15.6 5.6 15.6 10.4 12.5 13";
        fill: transparent;
        stroke: root.tint;
        stroke-width: 1.4px;
        stroke-line-cap: round;
    }
    if root.kind == "heart" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 8 14 L 2 8 C -2 3 4 -1 8 4 C 12 -1 18 3 14 8 Z";
        fill: root.tint;
    }
    if root.kind == "dislike" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 1 2 L 3 2 L 3 9 L 1 9 Z M 5 2 L 12 2 C 13 2 14 3 14 4 L 13 8 C 13 9 12 10 11 10 L 9 10 L 9 14 L 7 14 L 5 9 Z";
        fill: root.tint;
    }
    if root.kind == "equalizer" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M3 2V5 M3 9V14 M1 7H5 M8 2V9 M8 13V14 M6 11H10 M13 2V3 M13 7V14 M11 5H15";
        stroke: root.tint;
        stroke-width: 1.5px;
        stroke-line-cap: round;
    }
    if root.kind == "visualizer" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M2 13H7 M2 10H7 M2 7H7 M2 4H7 M9 13H14 M9 10H14 M9 7H14";
        stroke: root.tint;
        stroke-width: 2px;
    }
    if root.kind == "spectrum" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M2 14V7 M5 14V3 M8 14V6 M11 14V9 M14 14V11";
        stroke: root.tint;
        stroke-width: 2px;
    }
    if root.kind == "scope" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M1 8 H3 C5 8 4 2 6 2 S8 14 10 14 S11 8 13 8 H15";
        fill: transparent;
        stroke: root.tint;
        stroke-width: 1.6px;
        stroke-line-cap: round;
    }
    if root.kind == "waterfall" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M2 3H8 M11 3H14 M2 6H5 M8 6H13 M4 9H10 M12 9H14 M2 12H6 M9 12H14";
        stroke: root.tint;
        stroke-width: 1.8px;
    }
    if root.kind == "settings" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 6.622 3.194 L 6.784 1.106 L 9.216 1.106 L 9.378 3.194 L 10.424 3.627 L 12.015 2.266 L 13.734 3.985 L 12.373 5.576 L 12.806 6.622 L 14.894 6.784 L 14.894 9.216 L 12.806 9.378 L 12.373 10.424 L 13.734 12.015 L 12.015 13.734 L 10.424 12.373 L 9.378 12.806 L 9.216 14.894 L 6.784 14.894 L 6.622 12.806 L 5.576 12.373 L 3.985 13.734 L 2.266 12.015 L 3.627 10.424 L 3.194 9.378 L 1.106 9.216 L 1.106 6.784 L 3.194 6.622 L 3.627 5.576 L 2.266 3.985 L 3.985 2.266 L 5.576 3.627 Z M 8 5.5 C 6.619 5.5 5.5 6.619 5.5 8 C 5.5 9.381 6.619 10.5 8 10.5 C 9.381 10.5 10.5 9.381 10.5 8 C 10.5 6.619 9.381 5.5 8 5.5 Z";
        fill: root.tint;
    }
}

component ActionButton inherits Rectangle {
    in property <string> icon;
    in property <string> tip;
    in property <bool> active;
    in property <color> surface;
    callback clicked();
    width: 32px;
    height: 30px;
    border-radius: 8px;
    background: touch.pressed ? #ffffff24 : root.active ? #493020
        : touch.has-hover ? Theme.raised : root.surface;
    accessible-role: button;
    accessible-label: root.tip;
    accessible-action-default => { root.clicked(); }
    forward-focus: keys;
    border-width: keys.has-focus ? 1px : 0px;
    border-color: Theme.orange;
    keys := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if !event.modifiers.control && !event.modifiers.meta && !event.modifiers.shift &&
                !event.modifiers.alt && (event.text == Key.Return || event.text == " ") {
                if !event.repeat { root.clicked(); }
                return accept;
            }
            return reject;
        }
    }
    Glyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        kind: root.icon;
        tint: root.active ? Theme.orange : touch.has-hover ? Theme.text : Theme.muted;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Tooltip { text: @markdown("\{root.tip}"); }
}

export component PlaybackActions inherits HorizontalLayout {
    in property <bool> liked;
    in property <bool> disliked;
    in property <bool> eq-on;
    in-out property <VisualizationMode> visualizer-mode;
    in property <color> surface: Theme.panel;
    callback toggle-like();
    callback toggle-dislike();
    callback toggle-eq();
    spacing: 4px;
    horizontal-stretch: 0;
    cross-axis-alignment: center;
    ActionButton { icon: "heart"; tip: "Лайк"; surface: root.surface; active: root.liked; clicked => { root.toggle-like(); } }
    ActionButton { icon: "dislike"; tip: "Дизлайк"; surface: root.surface; active: root.disliked; clicked => { root.toggle-dislike(); } }
    Rectangle { width: 4px; }
    ActionButton { icon: "equalizer"; tip: "Эквалайзер"; surface: root.surface; active: root.eq-on; clicked => { root.toggle-eq(); } }
    ActionButton {
        icon: root.visualizer-mode == VisualizationMode.waterfall ? "waterfall"
            : root.visualizer-mode == VisualizationMode.scope ? "scope"
            : root.visualizer-mode == VisualizationMode.spectrum ? "spectrum" : "visualizer";
        tip: root.visualizer-mode == VisualizationMode.cover ? "Визуализация: обложка. Показать уровни L/R"
            : root.visualizer-mode == VisualizationMode.stereo ? "Визуализация: уровни L/R. Показать спектр"
            : root.visualizer-mode == VisualizationMode.spectrum ? "Визуализация: спектр. Показать осциллограмму"
            : root.visualizer-mode == VisualizationMode.scope ? "Визуализация: осциллограмма. Показать водопад"
            : "Визуализация: водопад. Показать обложку";
        surface: root.surface;
        active: root.visualizer-mode != VisualizationMode.cover;
        clicked => {
            root.visualizer-mode = root.visualizer-mode == VisualizationMode.cover ? VisualizationMode.stereo
                : root.visualizer-mode == VisualizationMode.stereo ? VisualizationMode.spectrum
                : root.visualizer-mode == VisualizationMode.spectrum ? VisualizationMode.scope
                : root.visualizer-mode == VisualizationMode.scope ? VisualizationMode.waterfall : VisualizationMode.cover;
        }
    }
}

export component TransportButton inherits Rectangle {
    in property <string> kind;
    in property <bool> primary: false;
    callback clicked();
    width: root.primary ? 40px : 32px;
    height: root.primary ? 40px : 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: root.primary ? 20px : 4px;
    background: root.primary
        ? (touch.pressed ? #dedede : touch.has-hover ? #ffffff : #f4f4f4)
        : (touch.pressed ? #ffffff24 : touch.has-hover ? #ffffff18 : transparent);

    pure function name-for(kind: string) -> string {
        if kind == "play" { "Воспроизведение" }
        else if kind == "pause" { "Пауза" }
        else if kind == "stop" { "Стоп" }
        else if kind == "prev" { "Предыдущий" }
        else if kind == "next" { "Следующий" }
        else { "" }
    }

    Glyph {
        kind: root.kind;
        tint: root.primary ? Theme.bg : Theme.text;
        x: (parent.width - self.width) / 2 + (root.kind == "play" ? 1px : 0px);
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Tooltip { text: @markdown("\{root.name-for(root.kind)}"); }
}

export component TitleButton inherits Rectangle {
    in property <string> glyph;
    in property <string> icon;
    in property <string> tip;
    callback clicked();
    width: 26px;
    height: 22px;
    border-radius: 3px;
    background: touch.pressed ? Theme.raised : touch.has-hover ? #353535 : transparent;

    if root.icon == "" : Text {
        width: 100%;
        height: 100%;
        text: root.glyph;
        color: touch.has-hover ? Theme.orange : Theme.text;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.icon != "" : Glyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        kind: root.icon;
        tint: touch.has-hover ? Theme.orange : Theme.text;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Tooltip { text: @markdown("\{root.tip}"); }
}
export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> hint: "Поиск";
    callback edited(string);
    min-width: 80px;
    min-height: 30px;
    preferred-height: 30px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    background: #161616;
    border-radius: 4px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.orange : #3c3c3c;
    clip: true;

    if root.text == "" : Text {
        x: 10px;
        width: parent.width - 20px;
        height: 100%;
        text: root.hint;
        color: Theme.dim;
        font-size: 13px;
        vertical-alignment: center;
    }

    input := TextInput {
        x: 10px;
        width: parent.width - (root.text == "" ? 20px : 42px);
        height: 100%;
        text <=> root.text;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        single-line: true;
        selection-background-color: Theme.orange;
        selection-foreground-color: #1b1b1b;
        edited => { root.edited(input.text); }
    }
    if root.text != "" : TitleButton {
        x: parent.width - self.width - 3px;
        y: (parent.height - self.height) / 2;
        glyph: "×";
        tip: "Очистить поиск";
        clicked => { root.text = ""; root.edited(""); }
    }
}

export component SeekBar inherits Rectangle {
    in property <float> position;
    in property <float> duration;
    in property <[float]> wave;
    in property <string> wave-message;
    in property <bool> seek-enabled: false;
    in property <length> bar-height: 28px;
    callback seek(float);
    height: root.bar-height;
    horizontal-stretch: 1;
    min-width: 48px;
    property <bool> dragging: false;
    property <float> progress: root.duration > 0 ? max(0, min(1, root.position / root.duration)) : 0;
    property <float> pointer-ratio: max(0, min(1, area.mouse-x / max(1px, area.width)));
    property <length> track-height: root.wave.length > 0 ? root.bar-height - 2px : 6px;
    property <int> columns: max(1, min(root.wave.length, ceil(root.width / 1px)));
    property <color> played: Theme.orange;
    property <color> idle: #7a7a7a;
    property <color> track: Theme.line;

    if root.wave.length == 0 && root.wave-message != "" : Text {
        y: 0px;
        width: 100%;
        height: 11px;
        text: root.wave-message;
        color: Theme.muted;
        font-size: 10px;
        horizontal-alignment: center;
        overflow: elide;
    }

    Rectangle {
        y: root.wave.length == 0 && root.wave-message != "" ? parent.height - self.height - 1px : (parent.height - self.height) / 2;
        width: 100%;
        height: root.track-height;
        background: root.wave.length > 0 ? transparent : root.track;
        border-radius: root.wave.length > 0 ? 0px : 3px;
        clip: true;

        if root.wave.length == 0 : Rectangle {
            x: 0px;
            width: parent.width * root.progress;
            height: 100%;
            background: root.played;
            border-radius: 3px;
        }

        if root.wave.length > 0 : Rectangle {
            width: 100%;
            height: 100%;

            for column in root.columns : Rectangle {
                property <float> at: (column + 0.5) / root.columns;
                property <float> source-at: at * root.wave.length - 0.5;
                property <int> left: max(0, min(root.wave.length - 1, floor(source-at)));
                property <int> right: min(root.wave.length - 1, left + 1);
                property <float> blend: max(0, min(1, source-at - left));
                property <float> sample: root.wave[left] * (1 - blend) + root.wave[right] * blend;
                property <float> level: max(0, min(1, sample * sample));
                x: column * parent.width / root.columns;
                width: parent.width / root.columns;
                height: max(1px, (parent.height - 4px) * level);
                y: (parent.height - self.height) / 2;
                background: at <= root.progress ? root.played : root.idle;
            }
            Rectangle {
                x: min(parent.width - 1px, parent.width * root.progress);
                width: 1px;
                height: 100%;
                background: root.played;
            }
        }
    }

    if area.has-hover && root.seek-enabled && root.duration > 0 : Rectangle {
        property <length> cursor-x: min(self.width - 1px, root.pointer-ratio * self.width);

        Rectangle {
            x: parent.cursor-x;
            width: 1px;
            height: 100%;
            background: Theme.text;
        }
        Rectangle {
            x: clamp(parent.cursor-x - self.width / 2, 0px, parent.width - self.width);
            y: 0px;
            width: min(parent.width, stamp.preferred-width + 12px);
            height: 17px;
            border-radius: 4px;
            background: Theme.raised;
            stamp := Text {
                property <int> total: floor(root.pointer-ratio * root.duration);
                property <int> seconds: mod(self.total, 60);
                text: "\{floor(self.total / 60)}:\{self.seconds < 10 ? "0" : ""}\{self.seconds}";
                color: Theme.text;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    area := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.seek-enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (root.seek-enabled && (event.kind == PointerEventKind.down || (event.kind == PointerEventKind.move && root.dragging))) {
                root.dragging = true;
                root.seek(root.pointer-ratio);
            }
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.dragging = false;
            }
        }
    }
}

export component VolumeBar inherits Rectangle {
    in property <float> volume;
    in property <bool> stretch: false;
    callback set-volume(float);
    horizontal-stretch: root.stretch ? 1 : 0;
    min-width: 72px;
    preferred-width: 96px;
    height: 22px;
    property <bool> dragging: false;

    Rectangle {
        y: (parent.height - 4px) / 2;
        width: 100%;
        height: 4px;
        background: #3a3a3a;
        border-radius: 2px;

        Rectangle {
            x: 0px;
            width: parent.width * max(0, min(1, root.volume));
            height: 100%;
            background: Theme.orange;
            border-radius: 2px;
        }
        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: Theme.orange;
            x: (parent.width - self.width) * max(0, min(1, root.volume));
            y: (parent.height - self.height) / 2;
        }
    }

    area := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down || (event.kind == PointerEventKind.move && root.dragging)) {
                root.dragging = true;
                root.set-volume(max(0, min(1, area.mouse-x / area.width)));
            }
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.dragging = false;
            }
        }
    }
}

component ModeChip inherits Rectangle {
    in property <string> glyph;
    in property <string> tip;
    in property <bool> active;
    callback clicked();
    width: 18px;
    height: 18px;
    border-radius: 3px;
    background: root.active ? (touch.has-hover ? #f0a04a : Theme.orange) : (touch.has-hover ? #3a3a3a : Theme.raised);

    Path {
        width: 18px;
        height: 18px;
        viewbox-width: 18;
        viewbox-height: 18;
        commands: root.glyph == "–" ? "M 5 9 L 13 9"
            : root.glyph == "☰" ? "M 5 4 L 13 4 L 13 14 L 5 14 Z M 5 8 L 13 8"
            : "M 4 4 L 14 4 L 14 14 L 4 14 Z M 7 4 L 7 14 M 11 4 L 11 14 M 4 11 L 14 11";
        fill: transparent;
        stroke: root.active ? #1b1b1b : (touch.has-hover ? Theme.text : Theme.muted);
        stroke-width: 1px;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Tooltip { text: @markdown("\{root.tip}"); }
}

export component EqButton inherits Rectangle {
    in property <string> label: "EQ";
    in property <string> icon: root.label == "♥" || root.label == "♥ альбом" ? "heart" : root.label == "нет" ? "dislike" : "";
    in property <string> tip;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();
    height: 28px;
    min-width: 28px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 3px;
    opacity: root.enabled ? 1 : 0.4;
    background: root.active
        ? (touch.has-hover ? #333333 : #1b1b1b)
        : (touch.has-hover ? Theme.raised : transparent);
    border-width: 1px;
    border-color: root.active || touch.has-hover ? Theme.orange : Theme.dim;
    property <string> shown-label: root.label == "♥" || root.label == "нет" ? "" : root.label == "♥ альбом" ? "альбом" : root.label;
    property <color> foreground: root.active || touch.has-hover ? Theme.orange : Theme.text;

    pure function name-for(label: string) -> string {
        if label == "EQ" { "Эквалайзер" }
        else if label == "♥" { "Лайк" }
        else if label == "нет" { "Дизлайк" }
        else if label == "♥ альбом" { "Лайк альбома" }
        else if label == "сеть" { "Поиск в сети" }
        else if label == "вкл" { "Выключить эквалайзер" }
        else if label == "выкл" { "Включить эквалайзер" }
        else if label == "сброс" { "Сбросить эквалайзер" }
        else { label }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 5px;
        alignment: center;
        cross-axis-alignment: center;
        if root.icon != "" : Glyph {
            kind: root.icon;
            tint: root.foreground;
        }
        if root.shown-label != "" : Text {
            text: root.shown-label;
            color: root.foreground;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    property <string> shown-tip: root.tip != "" ? root.tip : root.name-for(root.label);

    Tooltip { text: @markdown("\{root.shown-tip}"); }
}

export component EqSlider inherits Rectangle {
    in property <float> gain;
    in property <string> label;
    in property <string> tip;
    callback set-gain(float);
    horizontal-stretch: 1;
    min-width: 24px;
    property <bool> dragging: false;
    property <float> shown: max(-12, min(12, root.gain));
    // 0 is the top (+12 dB). 1 is the bottom (-12 dB).
    property <float> thumb: (12 - root.shown) / 24;

    VerticalLayout {
        spacing: 2px;
        alignment: center;

        track := Rectangle {
            height: 72px;
            vertical-stretch: 0;
            width: 100%;

            Rectangle {
                x: (parent.width - 4px) / 2;
                width: 4px;
                height: 100%;
                background: #3a3a3a;
                border-radius: 2px;
            }
            Rectangle {
                y: parent.height / 2;
                width: 100%;
                height: 1px;
                background: Theme.dim;
            }
            if root.shown > 0 : Rectangle {
                x: (parent.width - 4px) / 2;
                width: 4px;
                y: parent.height * root.thumb;
                height: parent.height / 2 - self.y;
                background: Theme.orange;
            }
            if root.shown < 0 : Rectangle {
                x: (parent.width - 4px) / 2;
                width: 4px;
                y: parent.height / 2;
                height: parent.height * root.thumb - parent.height / 2;
                background: Theme.orange;
            }
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: Theme.orange;
                x: (parent.width - self.width) / 2;
                y: parent.height * root.thumb - self.height / 2;
            }

            area := TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.dragging = true;
                        root.set-gain(root.db-at(area.mouse-y, area.height));
                    } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                        root.dragging = false;
                    } else if (event.kind == PointerEventKind.move && root.dragging) {
                        root.set-gain(root.db-at(area.mouse-y, area.height));
                    }
                }
            }
        }

        Text {
            height: 14px;
            vertical-stretch: 0;
            text: root.label;
            color: Theme.muted;
            font-size: 10px;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    property <string> shown-tip: root.tip != "" ? root.tip : root.label;
    Tooltip { text: @markdown("\{root.shown-tip}"); }

    pure function db-at(y: length, span: length) -> float {
        let ratio = max(0, min(1, y / max(span, 1px)));
        12 - ratio * 24
    }
}

export component Equalizer inherits Rectangle {
    in property <bool> enabled;
    in property <float> preamp;
    in property <[float]> bands;
    in property <[string]> preset-names;
    in-out property <string> preset-name;
    in-out property <int> preset-index;
    in property <string> preset-status;
    callback set-enabled(bool);
    callback set-preamp(float);
    callback set-band(int, float);
    callback reset();
    callback save-preset(string);
    callback apply-preset(int);
    background: Theme.panel;

    VerticalLayout {
        padding: 6px;
        spacing: 4px;

        HorizontalLayout {
            height: 32px;
            vertical-stretch: 0;
            spacing: 6px;
            cross-axis-alignment: center;
            EqButton {
                height: 22px;
                label: root.enabled ? "вкл" : "выкл";
                active: root.enabled;
                clicked => { root.set-enabled(!root.enabled); }
            }
            LineEdit {
                min-width: 85px;
                horizontal-stretch: 1;
                text <=> root.preset-name;
                placeholder-text: "Имя пресета";
                accessible-label: "Имя пресета эквалайзера";
                accepted(name) => { root.save-preset(name); }
            }
            EqButton {
                height: 26px;
                label: "Сохранить";
                tip: "Сохранить предусиление и 10 полос. Существующий пресет с таким именем будет заменён.";
                enabled: root.preset-name != "";
                clicked => { root.save-preset(root.preset-name); }
            }
            EqButton {
                height: 22px;
                label: "сброс";
                clicked => { root.reset(); }
            }
        }

        HorizontalLayout {
            height: 32px;
            vertical-stretch: 0;
            spacing: 6px;
            cross-axis-alignment: center;
            ComboBox {
                width: 156px;
                model: root.preset-names;
                current-index <=> root.preset-index;
                accessible-label: "Встроенные и мои пресеты эквалайзера";
                selected(_) => { root.apply-preset(self.current-index); }
            }
            EqButton {
                height: 26px;
                label: "Применить";
                tip: "Загрузить выбранную кривую, не меняя вкл/выкл эквалайзера";
                clicked => { root.apply-preset(root.preset-index); }
            }
            Rectangle {
                min-width: 0px;
                horizontal-stretch: 1;
                height: 32px;
                message := Text {
                    width: 100%;
                    height: 100%;
                    text: root.preset-status != "" ? root.preset-status : "Выберите готовый пресет или сохраните свой";
                    font-size: 12px;
                    color: Theme.muted;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Tooltip { text: @markdown("\{message.text}"); }
            }
        }

        HorizontalLayout {
            height: 94px;
            vertical-stretch: 0;
            spacing: 2px;
            EqSlider {
                label: "Пр";
                tip: "Предусиление";
                gain: root.preamp;
                set-gain(value) => { root.set-preamp(value); }
            }
            for value[index] in root.bands : EqSlider {
                label: index == 0 ? "31" : index == 1 ? "62" : index == 2 ? "125" : index == 3 ? "250" : index == 4 ? "500" : index == 5 ? "1k" : index == 6 ? "2k" : index == 7 ? "4k" : index == 8 ? "8k" : "16k";
                tip: index == 0 ? "31 Гц" : index == 1 ? "62 Гц" : index == 2 ? "125 Гц" : index == 3 ? "250 Гц" : index == 4 ? "500 Гц" : index == 5 ? "1 кГц" : index == 6 ? "2 кГц" : index == 7 ? "4 кГц" : index == 8 ? "8 кГц" : "16 кГц";
                gain: value;
                set-gain(next) => { root.set-band(index, next); }
            }
        }
    }
}

// The topmost area handles only context-menu input. Left clicks fall through
// to the dots or to the existing play, download and drag controls.
export component TrackActions inherits Rectangle {
    in property <TrackList> list <=> menu.list;
    in property <int> source <=> menu.source;
    in property <string> song-id <=> menu.song-id;
    in property <bool> identified <=> menu.identified;
    in property <bool> can-next <=> menu.can-next;
    in property <bool> can-end <=> menu.can-end;
    in property <string> track-title;
    in property <bool> row-active;
    in property <bool> tab-stop: true;
    in property <bool> keyboard-selected;
    in property <length> button-y: (root.height - dots.height) / 2;
    width: 100%;
    height: 100%;

    public function open-menu() {
        menu.show({ x: dots.x, y: dots.y + dots.height });
    }

    dots := Rectangle {
        x: parent.width - self.width;
        y: root.button-y;
        width: 28px; height: 24px;
        accessible-role: button;
        accessible-label: "Действия с треком: " + root.track-title;
        accessible-action-default => { root.open-menu(); }
        forward-focus: keys;
        property <bool> focused: keys.has-focus || root.keyboard-selected;
        border-radius: 4px;
        border-width: self.focused ? 1px : 0px;
        border-color: Theme.orange;
        background: touch.has-hover ? Theme.raised : transparent;
        for dot[index] in 3 : Rectangle {
            visible: root.row-active || dots.focused || touch.has-hover;
            width: 3px; height: 3px;
            border-radius: 1.5px;
            x: (dots.width - 15px) / 2 + index * 6px;
            y: (dots.height - self.height) / 2;
            background: dots.focused || touch.has-hover ? Theme.orange : Theme.text;
        }
        keys := FocusScope {
            enabled: root.tab-stop;
            focus-on-click: false;
            key-pressed(event) => {
                if !event.modifiers.control && !event.modifiers.meta && !event.modifiers.shift &&
                    !event.modifiers.alt && (event.text == Key.Return || event.text == " ") {
                    if !event.repeat { root.open-menu(); }
                    return accept;
                }
                return reject;
            }
        }
        touch := TouchArea { mouse-cursor: pointer; clicked => { root.open-menu(); } }
        Tooltip { text: @markdown("Действия с треком"); }
    }
    menu := TrackMenu {}
}

export component QueueRow inherits Rectangle {
    in property <QueueItem> item;
    in property <TrackList> list;
    callback clicked();
    height: 32px;
    background: root.item.current ? Theme.orange : (touch.has-hover ? Theme.raised : transparent);

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 34px;
        spacing: 8px;
        cross-axis-alignment: center;

        if root.item.number != "" : Text {
            text: root.item.number;
            color: root.item.current ? #1b1b1b : Theme.muted;
            font-size: 12px;
            min-width: 18px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text { text: root.item.title; color: root.item.current ? #1b1b1b : Theme.text; font-size: 13px; overflow: elide; }
            if root.item.meta != "" : Text { text: root.item.meta; color: Theme.muted; font-size: 10px; overflow: elide; }
        }
        if root.item.liked : Glyph {
            kind: "heart"; tint: Theme.orange;
            width: 13px; height: 13px;
            accessible-role: image; accessible-label: "В понравившихся";
        }
        Text {
            text: root.item.duration;
            color: root.item.current ? #3a240f : Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    TrackActions {
        list: root.list; source: root.item.source;
        song-id: root.item.song-id; identified: root.item.identified;
        track-title: root.item.title; row-active: touch.has-hover;
    }
}

// Observe the entire result (including its secondary actions) before the
// individual controls receive the pointer event.
component CatalogLayout inherits TouchArea {
    VerticalLayout { @children }
}

export component CatalogRow inherits Rectangle {
    in property <CatalogHit> hit;
    in property <int> source;
    callback clicked();
    callback download();
    callback check-source();
    height: 44px + (root.hit.section == "" ? 0px : 28px) + (root.hit.is-album ? 0px : 24px);

    surface := CatalogLayout {
        if root.hit.section != "" : Rectangle {
            height: 28px;
            Text {
                x: 8px;
                width: parent.width - 16px;
                height: 100%;
                text: root.hit.section;
                color: Theme.orange;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle {
                x: 8px;
                y: parent.height - 1px;
                width: parent.width - 16px;
                height: 1px;
                background: Theme.line;
            }
        }
        Rectangle {
            height: 44px;
            background: touch.has-hover ? Theme.raised : transparent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: root.hit.is-album ? 8px : 34px;
                spacing: 8px;
                cross-axis-alignment: center;
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    height: 44px;
                    HorizontalLayout {
                        spacing: 8px;
                        cross-axis-alignment: center;
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            if root.hit.is-album : Rectangle {
                                x: 2px;
                                y: 2px;
                                width: 24px;
                                height: 24px;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: Theme.muted;
                                Rectangle {
                                    x: 6px;
                                    y: 6px;
                                    width: 12px;
                                    height: 12px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: Theme.muted;
                                }
                            }
                            if !root.hit.is-album : Glyph {
                                x: 6px;
                                y: 6px;
                                kind: "play";
                                tint: Theme.orange;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            spacing: 1px;
                            Text {
                                text: root.hit.title;
                                color: Theme.text;
                                font-size: 13px;
                                overflow: elide;
                            }
                            Text {
                                text: root.hit.artist == "" ? root.hit.detail : (root.hit.detail == "" ? root.hit.artist : root.hit.artist + " · " + root.hit.detail);
                                color: Theme.muted;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                    }
                    touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { root.clicked(); }
                    }
                }
                EqButton {
                    width: 72px;
                    label: root.hit.action;
                    active: root.hit.action == "играть" || root.hit.action == "слушать";
                    enabled: root.hit.action != "качается";
                    clicked => { root.clicked(); }
                }
                if root.hit.download-action != "" : EqButton {
                    width: 72px;
                    label: root.hit.download-action;
                    tip: "Скачать в библиотеку";
                    enabled: root.hit.can-download;
                    clicked => { root.download(); }
                }
            }
        }
        if !root.hit.is-album : HorizontalLayout {
            height: 24px;
            padding-left: 44px;
            padding-right: 8px;
            spacing: 8px;
            alignment: start;
            cross-axis-alignment: center;
            Text { text: root.hit.availability; color: Theme.muted; font-size: 11px; overflow: elide; }
            if root.hit.can-check-source : EqButton {
                width: 70px;
                height: 22px;
                label: "Уточнить";
                tip: "Узнать источник без воспроизведения";
                clicked => { root.check-source(); }
            }
        }
    }
    if !root.hit.is-album : TrackActions {
        y: root.hit.section == "" ? 0px : 28px;
        height: parent.height - self.y;
        button-y: 10px;
        list: TrackList.catalog; source: root.source; song-id: root.hit.song-id;
        identified: true; track-title: root.hit.title;
        row-active: surface.has-hover && surface.mouse-y >= self.y;
    }
}

export component CoverArt inherits Rectangle {
    in property <image> cover;
    in property <bool> has-cover;
    in property <length> mark: 56px;
    background: Theme.raised;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;

    if !root.has-cover : Image {
        source: @image-url("../assets/icon.png");
        width: root.mark;
        height: root.mark;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
    }
    if root.has-cover : Image {
        source: root.cover;
        width: 100%;
        height: 100%;
        image-fit: ImageFit.cover;
    }
}

export struct StereoLevels {
    left: float,
    right: float,
    peak-left: float,
    peak-right: float,
}

component MeterChannel inherits Rectangle {
    in property <string> label;
    in property <float> level;
    in property <float> peak;
    private property <length> rail-top: root.height * 0.60;
    private property <length> rail-height: root.height * 0.32;

    Text {
        x: 0px;
        y: 0px;
        height: root.rail-top - 2px;
        vertical-alignment: bottom;
        text: root.label;
        font-size: clamp(root.height * 0.4, 9px, 14px);
        font-weight: 600;
        color: Theme.text;
    }
    for tick[i] in 4 : Rectangle {
        width: 1px;
        height: clamp(root.height * 0.10, 2px, 4px);
        x: (root.width - self.width) * (i + 1) / 4;
        y: root.rail-top - self.height - 2px;
        background: Theme.dim;
    }
    Rectangle {
        y: root.rail-top;
        width: 100%;
        height: root.rail-height;
        border-radius: 2px;
        background: Theme.line;
        Rectangle {
            x: 0px;
            width: parent.width * clamp(root.level, 0, 1);
            height: 100%;
            border-radius: min(2px, self.width / 2);
            background: Theme.orange;
        }
        Rectangle {
            visible: root.peak > 0;
            width: clamp(root.width * 0.018, 2px, 3px);
            height: parent.height + 2px;
            x: (parent.width - self.width) * clamp(root.peak, 0, 1);
            y: -1px;
            background: Theme.text;
        }
    }
}

component ScopeTrace inherits Rectangle {
    in property <[float]> samples;

    pure function sample-y(index: int) -> float {
        let amplitude = index < root.samples.length ? root.samples[index] : 0;
        return root.height / 1px * (0.5 - 0.48 * amplitude);
    }

    for tick[i] in 3 : Rectangle {
        width: 1px;
        height: 100%;
        x: root.width * (i + 1) / 4 - self.width / 2;
        background: Theme.line;
    }
    for tick[i] in 3 : Rectangle {
        width: 100%;
        height: 1px;
        y: root.height * (i + 1) / 4 - self.height / 2;
        background: i == 1 ? Theme.dim.transparentize(50%) : Theme.line;
    }

    // Slint cannot repeat LineTo inside a Path. Five adjoining strokes cover
    // the 95 intervals, sharing their endpoints without one item per sample.
    for chunk[i] in 5 : trace := Path {
        private property <int> first: i * 19;
        private property <float> step: self.width / 1px / 19;
        x: root.width * i / 5;
        y: 0px;
        width: root.width / 5;
        height: root.height;
        fit: preserve;
        fill: transparent;
        stroke: Theme.orange;
        stroke-width: clamp(root.height * 0.012, 1px, 1.75px);
        stroke-line-cap: round;
        MoveTo { x: 0; y: root.sample-y(trace.first); }
        LineTo { x: trace.step; y: root.sample-y(trace.first + 1); }
        LineTo { x: 2 * trace.step; y: root.sample-y(trace.first + 2); }
        LineTo { x: 3 * trace.step; y: root.sample-y(trace.first + 3); }
        LineTo { x: 4 * trace.step; y: root.sample-y(trace.first + 4); }
        LineTo { x: 5 * trace.step; y: root.sample-y(trace.first + 5); }
        LineTo { x: 6 * trace.step; y: root.sample-y(trace.first + 6); }
        LineTo { x: 7 * trace.step; y: root.sample-y(trace.first + 7); }
        LineTo { x: 8 * trace.step; y: root.sample-y(trace.first + 8); }
        LineTo { x: 9 * trace.step; y: root.sample-y(trace.first + 9); }
        LineTo { x: 10 * trace.step; y: root.sample-y(trace.first + 10); }
        LineTo { x: 11 * trace.step; y: root.sample-y(trace.first + 11); }
        LineTo { x: 12 * trace.step; y: root.sample-y(trace.first + 12); }
        LineTo { x: 13 * trace.step; y: root.sample-y(trace.first + 13); }
        LineTo { x: 14 * trace.step; y: root.sample-y(trace.first + 14); }
        LineTo { x: 15 * trace.step; y: root.sample-y(trace.first + 15); }
        LineTo { x: 16 * trace.step; y: root.sample-y(trace.first + 16); }
        LineTo { x: 17 * trace.step; y: root.sample-y(trace.first + 17); }
        LineTo { x: 18 * trace.step; y: root.sample-y(trace.first + 18); }
        LineTo { x: 19 * trace.step; y: root.sample-y(trace.first + 19); }
    }
}

// Only the now-playing artwork switches; library and album covers keep using CoverArt.
export component NowPlayingArt inherits Rectangle {
    in property <VisualizationMode> visualizer-mode;
    in property <[float]> spectrum-levels;
    in property <[float]> scope-samples;
    in property <image> waterfall-image;
    in property <bool> draw-visualizer: true;
    in property <bool> expanded;
    callback toggle-expanded();
    in property <StereoLevels> levels;
    in property <image> cover;
    in property <bool> has-cover;
    in property <length> mark: 56px;

    if root.visualizer-mode == VisualizationMode.cover : CoverArt {
        cover: root.cover;
        has-cover: root.has-cover;
        mark: root.mark;
    }
    if root.draw-visualizer && root.visualizer-mode != VisualizationMode.cover : Rectangle {
        background: Theme.bg;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.line;
        if root.visualizer-mode == VisualizationMode.stereo : VerticalLayout {
            padding-left: root.width * 0.10;
            padding-right: root.width * 0.10;
            padding-top: root.height * 0.10;
            padding-bottom: root.height * 0.10;
            spacing: root.height * 0.08;
            MeterChannel { vertical-stretch: 1; label: "L"; level: root.levels.left; peak: root.levels.peak-left; }
            MeterChannel { vertical-stretch: 1; label: "R"; level: root.levels.right; peak: root.levels.peak-right; }
        }
        if root.visualizer-mode == VisualizationMode.scope : ScopeTrace {
            x: root.width * 0.08;
            y: root.height * 0.10;
            width: root.width - 2 * self.x;
            height: root.height - 2 * self.y;
            samples: root.scope-samples;
        }
        if root.visualizer-mode == VisualizationMode.spectrum : plot := Rectangle {
            x: root.width * 0.08;
            y: root.height * 0.10;
            width: root.width - 2 * self.x;
            height: root.height - 2 * self.y;
            property <length> gap: max(1px, plot.width * 0.019);
            property <int> band-count: 10;
            for line[i] in 4 : Rectangle {
                width: 100%;
                height: 1px;
                y: (plot.height - self.height) * (i + 1) / 4;
                background: Theme.line;
            }
            // Keep the bars in place even when a new sample model arrives.
            for band[i] in plot.band-count : Rectangle {
                width: (plot.width - plot.gap * (plot.band-count - 1)) / plot.band-count;
                x: (self.width + plot.gap) * i;
                height: i < root.spectrum-levels.length ? plot.height * clamp(root.spectrum-levels[i], 0, 1) : 0px;
                y: plot.height - self.height;
                border-radius: min(2px, self.height / 2);
                background: Theme.orange;
            }
        }
        if root.visualizer-mode == VisualizationMode.waterfall : Image {
            x: root.width * 0.08;
            y: root.height * 0.10;
            width: root.width - 2 * self.x;
            height: root.height - 2 * self.y;
            source: root.waterfall-image;
            image-fit: fill;
        }
        TouchArea {
            mouse-cursor: pointer;
            double-clicked => { root.toggle-expanded(); }
        }
        if !root.expanded : Rectangle {
            Tooltip { text: @markdown("Двойной щелчок — развернуть на всё окно"); }
        }
    }
}

export component Heading inherits HorizontalLayout {
    in property <string> title;
    in property <string> aside;
    in property <length> title-size: 13px;
    spacing: 8px;
    padding-left: 4px;
    padding-right: 4px;
    cross-axis-alignment: center;

    Text {
        text: root.title;
        color: Theme.orange;
        font-size: root.title-size;
        font-weight: 600;
        overflow: elide;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    @children
    Text {
        text: root.aside;
        color: Theme.dim;
        font-size: 11px;
        vertical-alignment: center;
    }
}

export component EmptyNote inherits Rectangle {
    in property <string> message;
    in property <bool> error: false;
    width: 100%;
    height: 100%;
    Text {
        width: 100%;
        height: 100%;
        text: root.message;
        color: root.error ? Theme.orange : Theme.dim;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

export component VerticalScrollBar inherits Rectangle {
    in property <length> content-height;
    in-out property <length> scroll-y;
    width: 7px;
    visible: root.content-height > root.height + 2px;
    property <length> extent: max(0px, root.content-height - root.height);
    property <length> thumb-h: min(root.height, max(18px, root.height * root.height / max(root.content-height, 1px)));
    property <length> travel: max(0px, root.height - root.thumb-h);
    property <float> scrolled: max(0, min(1, -root.scroll-y / max(root.extent, 1px)));
    property <bool> dragging: false;
    property <length> grab-offset: 0px;

    Rectangle {
        x: 2px;
        y: root.scrolled * root.travel;
        width: drag.has-hover || root.dragging ? 5px : 3px;
        height: root.thumb-h;
        border-radius: 2px;
        background: root.dragging ? Theme.orange : (drag.has-hover ? Theme.muted : #ffffff28);
    }
    drag := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.grab-offset = self.mouse-y >= root.scrolled * root.travel && self.mouse-y <= root.scrolled * root.travel + root.thumb-h
                    ? self.mouse-y - root.scrolled * root.travel : root.thumb-h / 2;
                root.dragging = true;
            }
            if root.dragging && (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move) {
                root.scroll-y = -root.extent * max(0, min(1, (self.mouse-y - root.grab-offset) / max(root.travel, 1px)));
            }
            if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                root.dragging = false;
            }
        }
        scroll-event(event) => {
            root.scroll-y = max(-root.extent, min(0px, root.scroll-y + event.delta-y));
            accept
        }
    }
}

export component ScrollPort inherits Rectangle {
    in-out property <length> scroll-y <=> flick.content-y;
    clip: true;
    width: 100%;
    height: 100%;
    vertical-stretch: 1;
    horizontal-stretch: 1;


    flick := Flickable {
        x: 0px;
        // Reserve the gutter even without overflow: wrapped text must not
        // change its width when its own height causes a scrollbar.
        width: parent.width - 7px;
        height: 100%;
        content-width: self.width;
        VerticalLayout {
            alignment: start;
            @children
        }
    }

    VerticalScrollBar {
        x: parent.width - self.width;
        y: 0px;
        height: flick.height;
        content-height: flick.content-height;
        scroll-y <=> flick.content-y;
    }
}

export component ModeSwitch inherits HorizontalLayout {
    in property <int> mode;
    callback set-mode(int);
    horizontal-stretch: 0;
    spacing: 3px;
    alignment: center;

    ModeChip { glyph: "–"; tip: "Компактный вид"; active: root.mode == 0; clicked => { root.set-mode(0); } }
    ModeChip { glyph: "☰"; tip: "Средний вид"; active: root.mode == 1; clicked => { root.set-mode(1); } }
    ModeChip { glyph: "▦"; tip: "Большой вид"; active: root.mode == 2; clicked => { root.set-mode(2); } }
}

export component PlaybackStatus inherits Rectangle {
    in property <string> message;
    in property <bool> busy;
    in property <bool> error;
    height: 16px;
    min-width: 32px;
    horizontal-stretch: 1;
    Text {
        width: 100%;
        height: 100%;
        text: (root.busy ? "… " : "") + root.message;
        color: root.error ? Theme.orange : Theme.muted;
        font-size: 11px;
        vertical-alignment: center;
        overflow: elide;
    }
    Tooltip { text: @markdown("\{root.message}"); }
}
