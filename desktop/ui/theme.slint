import { LineEdit } from "std-widgets.slint";

export global Theme {
    out property <color> bg: #1b1b1b;
    out property <color> panel: #242424;
    out property <color> raised: #2c2c2c;
    out property <color> orange: #e8872a;
    out property <color> text: #f3f3f3;
    out property <color> muted: #a3a3a3;
    out property <color> dim: #6f6f6f;
}

export component SearchField inherits Rectangle {
    in-out property <string> text;
    callback edited(string);
    min-height: 32px;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    LineEdit {
        width: 100%;
        placeholder-text: "Поиск";
        text <=> root.text;
        edited(value) => { root.edited(value); }
    }
}

export component IconButton inherits Rectangle {
    in property <string> glyph;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: touch.pressed ? Theme.raised : transparent;

    Text {
        width: 100%;
        height: 100%;
        text: root.glyph;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component TitleButton inherits Rectangle {
    in property <string> glyph;
    callback clicked();
    width: 26px;
    height: 22px;
    border-radius: 3px;
    background: touch.pressed ? Theme.raised : transparent;

    Text {
        width: 100%;
        height: 100%;
        text: root.glyph;
        color: Theme.text;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component SeekBar inherits Rectangle {
    in property <float> position;
    in property <float> duration;
    in property <[float]> wave;
    callback seek(float);
    // Empty wave keeps the flat orange strip. Bars sit on the same dark track.
    height: 22px;
    property <float> progress: min(1, root.position / max(root.duration, 0.001));
    property <length> track-height: root.wave.length > 0 ? 16px : 8px;

    Rectangle {
        y: (parent.height - self.height) / 2;
        width: 100%;
        height: root.track-height;
        background: #3a3a3a;
        border-radius: 4px;
        clip: true;

        if root.wave.length == 0 : Rectangle {
            width: parent.width * root.progress;
            height: 100%;
            background: Theme.orange;
            border-radius: 4px;
        }

        if root.wave.length > 0 : Rectangle {
            width: 100%;
            height: 100%;

            for sample[index] in root.wave : Rectangle {
                property <float> at: (index + 0.5) / root.wave.length;
                x: index * parent.width / root.wave.length;
                width: max(1px, parent.width / root.wave.length - 1px);
                height: max(2px, parent.height * max(0.12, min(1, sample)));
                y: (parent.height - self.height) / 2;
                background: at <= root.progress ? Theme.orange : #9a9a9a;
            }
        }
    }

    area := TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.seek(area.mouse-x / area.width);
            }
        }
    }
}

export component VolumeBar inherits Rectangle {
    in property <float> volume;
    in property <bool> stretch: false;
    callback set-volume(float);
    horizontal-stretch: root.stretch ? 1 : 0;
    min-width: 72px;
    preferred-width: 88px;
    height: 22px;

    Rectangle {
        y: (parent.height - 8px) / 2;
        width: 100%;
        height: 8px;
        background: #3a3a3a;
        border-radius: 4px;

        Rectangle {
            width: parent.width * max(0, min(1, root.volume));
            height: 100%;
            background: Theme.orange;
            border-radius: 4px;
        }
    }

    area := TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.set-volume(area.mouse-x / area.width);
            }
        }
    }
}

component ModeChip inherits Rectangle {
    in property <string> glyph;
    in property <bool> active;
    callback clicked();
    width: 18px;
    height: 18px;
    border-radius: 3px;
    background: root.active ? Theme.orange : Theme.raised;

    Text {
        width: 100%;
        height: 100%;
        text: root.glyph;
        color: root.active ? #1b1b1b : Theme.muted;
        font-size: 10px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

export component EqButton inherits Rectangle {
    in property <string> label: "EQ";
    in property <bool> active;
    callback clicked();
    height: 22px;
    border-radius: 3px;
    background: root.active ? #1b1b1b : transparent;
    border-width: 1px;
    border-color: root.active ? Theme.orange : Theme.dim;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        alignment: center;
        Text {
            text: root.label;
            color: root.active ? Theme.orange : Theme.text;
            font-size: 10px;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

export component EqSlider inherits Rectangle {
    in property <float> gain;
    in property <string> label;
    callback set-gain(float);
    horizontal-stretch: 1;
    min-width: 24px;
    property <bool> dragging: false;
    property <float> shown: max(-12, min(12, root.gain));
    // 0 is the top (+12 dB). 1 is the bottom (-12 dB).
    property <float> thumb: (12 - root.shown) / 24;

    VerticalLayout {
        spacing: 2px;
        alignment: center;

        track := Rectangle {
            height: 72px;
            width: 100%;

            Rectangle {
                x: (parent.width - 4px) / 2;
                width: 4px;
                height: 100%;
                background: #3a3a3a;
                border-radius: 2px;
            }
            Rectangle {
                y: parent.height / 2;
                width: 100%;
                height: 1px;
                background: Theme.dim;
            }
            if root.shown > 0 : Rectangle {
                x: (parent.width - 4px) / 2;
                width: 4px;
                y: parent.height * root.thumb;
                height: parent.height / 2 - self.y;
                background: Theme.orange;
            }
            if root.shown < 0 : Rectangle {
                x: (parent.width - 4px) / 2;
                width: 4px;
                y: parent.height / 2;
                height: parent.height * root.thumb - parent.height / 2;
                background: Theme.orange;
            }
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: Theme.orange;
                x: (parent.width - self.width) / 2;
                y: parent.height * root.thumb - self.height / 2;
            }

            area := TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.dragging = true;
                        root.set-gain(root.db-at(area.mouse-y, area.height));
                    } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                        root.dragging = false;
                    } else if (event.kind == PointerEventKind.move && root.dragging) {
                        root.set-gain(root.db-at(area.mouse-y, area.height));
                    }
                }
            }
        }

        Text {
            text: root.label;
            color: Theme.muted;
            font-size: 9px;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    pure function db-at(y: length, span: length) -> float {
        let ratio = max(0, min(1, y / max(span, 1px)));
        12 - ratio * 24
    }
}

export component Equalizer inherits Rectangle {
    in property <bool> enabled;
    in property <float> preamp;
    in property <[float]> bands;
    callback set-enabled(bool);
    callback set-preamp(float);
    callback set-band(int, float);
    callback reset();
    height: 132px;
    background: Theme.panel;

    VerticalLayout {
        padding: 6px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 6px;
            alignment: center;
            EqButton {
                label: root.enabled ? "вкл" : "выкл";
                active: root.enabled;
                clicked => { root.set-enabled(!root.enabled); }
            }
            Rectangle { horizontal-stretch: 1; }
            EqButton {
                label: "сброс";
                clicked => { root.reset(); }
            }
        }

        HorizontalLayout {
            spacing: 2px;
            alignment: center;
            EqSlider {
                label: "Пр";
                gain: root.preamp;
                set-gain(value) => { root.set-preamp(value); }
            }
            for value[index] in root.bands : EqSlider {
                label: index == 0 ? "31" : index == 1 ? "62" : index == 2 ? "125" : index == 3 ? "250" : index == 4 ? "500" : index == 5 ? "1k" : index == 6 ? "2k" : index == 7 ? "4k" : index == 8 ? "8k" : "16k";
                gain: value;
                set-gain(next) => { root.set-band(index, next); }
            }
        }
    }
}

export component ModeSwitch inherits HorizontalLayout {
    in property <int> mode;
    callback set-mode(int);
    spacing: 3px;
    alignment: center;

    ModeChip { glyph: "–"; active: root.mode == 0; clicked => { root.set-mode(0); } }
    ModeChip { glyph: "☰"; active: root.mode == 1; clicked => { root.set-mode(1); } }
    ModeChip { glyph: "▦"; active: root.mode == 2; clicked => { root.set-mode(2); } }
}
