import { CatalogHit, QueueItem } from "types.slint";

export global Theme {
    out property <color> bg: #1b1b1b;
    out property <color> panel: #242424;
    out property <color> raised: #2c2c2c;
    out property <color> line: #333333;
    out property <color> orange: #e8872a;
    out property <color> text: #f3f3f3;
    out property <color> muted: #a3a3a3;
    out property <color> dim: #8a8a8a;
}


export component Glyph inherits Rectangle {
    in property <string> kind;
    in property <color> tint: Theme.text;
    width: 16px;
    height: 16px;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    if root.kind == "play" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 5 2 L 14 8 L 5 14 Z";
        fill: root.tint;
    }
    if root.kind == "pause" : Rectangle {
        x: 3px;
        y: 2px;
        width: 3px;
        height: 12px;
        background: root.tint;
    }
    if root.kind == "pause" : Rectangle {
        x: 10px;
        y: 2px;
        width: 3px;
        height: 12px;
        background: root.tint;
    }
    if root.kind == "stop" : Rectangle {
        x: 3px;
        y: 3px;
        width: 10px;
        height: 10px;
        background: root.tint;
    }
    if root.kind == "prev" : Rectangle {
        x: 2px;
        y: 2px;
        width: 2px;
        height: 12px;
        background: root.tint;
    }
    if root.kind == "prev" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 14 2 L 6 8 L 14 14 Z";
        fill: root.tint;
    }
    if root.kind == "next" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 2 2 L 10 8 L 2 14 Z";
        fill: root.tint;
    }
    if root.kind == "next" : Rectangle {
        x: 12px;
        y: 2px;
        width: 2px;
        height: 12px;
        background: root.tint;
    }
    if root.kind == "speaker" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 1 6 L 5 6 L 9 2 L 9 14 L 5 10 L 1 10 Z";
        fill: root.tint;
    }
    if root.kind == "heart" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 8 14 L 2 8 C -2 3 4 -1 8 4 C 12 -1 18 3 14 8 Z";
        fill: root.tint;
    }
    if root.kind == "dislike" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 1 2 L 3 2 L 3 9 L 1 9 Z M 5 2 L 12 2 C 13 2 14 3 14 4 L 13 8 C 13 9 12 10 11 10 L 9 10 L 9 14 L 7 14 L 5 9 Z";
        fill: root.tint;
    }
}

export component TransportButton inherits Rectangle {
    in property <string> kind;
    in property <bool> primary: false;
    in property <bool> inverted: false;
    callback clicked();
    width: root.primary ? 40px : 32px;
    height: root.primary ? 40px : 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: root.primary ? 20px : 4px;
    background: root.primary
        ? (touch.pressed ? #dedede : touch.has-hover ? #ffffff : #f4f4f4)
        : (touch.pressed
            ? (root.inverted ? #00000033 : #ffffff24)
            : touch.has-hover
                ? (root.inverted ? #00000022 : #ffffff18)
                : transparent);

    pure function name-for(kind: string) -> string {
        if kind == "play" { "Воспроизведение" }
        else if kind == "pause" { "Пауза" }
        else if kind == "stop" { "Стоп" }
        else if kind == "prev" { "Предыдущий" }
        else if kind == "next" { "Следующий" }
        else { "" }
    }

    Glyph {
        kind: root.kind;
        tint: (root.primary || root.inverted) ? #1b1b1b : Theme.text;
        x: (parent.width - self.width) / 2 + (root.kind == "play" ? 1px : 0px);
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Tooltip { text: @markdown("\{root.name-for(root.kind)}"); }
}

export component TitleButton inherits Rectangle {
    in property <string> glyph;
    in property <string> tip;
    callback clicked();
    width: 26px;
    height: 22px;
    border-radius: 3px;
    background: touch.pressed ? Theme.raised : touch.has-hover ? #353535 : transparent;

    Text {
        width: 100%;
        height: 100%;
        text: root.glyph;
        color: touch.has-hover ? Theme.orange : Theme.text;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Tooltip { text: @markdown("\{root.tip}"); }
}
export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> hint: "Поиск";
    callback edited(string);
    min-width: 80px;
    min-height: 30px;
    preferred-height: 30px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    background: #161616;
    border-radius: 4px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.orange : #3c3c3c;
    clip: true;

    if root.text == "" : Text {
        x: 10px;
        width: parent.width - 20px;
        height: 100%;
        text: root.hint;
        color: Theme.dim;
        font-size: 13px;
        vertical-alignment: center;
    }

    input := TextInput {
        x: 10px;
        width: parent.width - (root.text == "" ? 20px : 42px);
        height: 100%;
        text <=> root.text;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        single-line: true;
        selection-background-color: Theme.orange;
        selection-foreground-color: #1b1b1b;
        edited => { root.edited(input.text); }
    }
    if root.text != "" : TitleButton {
        x: parent.width - self.width - 3px;
        y: (parent.height - self.height) / 2;
        glyph: "×";
        tip: "Очистить поиск";
        clicked => { root.text = ""; root.edited(""); }
    }
}

export component SeekBar inherits Rectangle {
    in property <float> position;
    in property <float> duration;
    in property <[float]> wave;
    in property <bool> seek-enabled: false;
    in property <bool> inverted: false;
    in property <length> bar-height: 28px;
    callback seek(float);
    height: root.bar-height;
    horizontal-stretch: 1;
    min-width: 48px;
    property <bool> dragging: false;
    property <float> progress: root.duration > 0 ? max(0, min(1, root.position / root.duration)) : 0;
    property <length> track-height: root.wave.length > 0 ? root.bar-height - 2px : 6px;
    property <color> played: root.inverted ? #ffffff : Theme.orange;
    property <color> idle: root.inverted ? #ffffff99 : #7a7a7a;
    property <color> track: root.inverted ? #00000033 : #333333;

    Rectangle {
        y: (parent.height - self.height) / 2;
        width: 100%;
        height: root.track-height;
        background: root.wave.length > 0 ? transparent : root.track;
        border-radius: root.wave.length > 0 ? 0px : 3px;
        clip: true;

        if root.wave.length == 0 : Rectangle {
            x: 0px;
            width: parent.width * root.progress;
            height: 100%;
            background: root.played;
            border-radius: 3px;
        }

        if root.wave.length > 0 : Rectangle {
            width: 100%;
            height: 100%;

            for sample[index] in root.wave : Rectangle {
                property <float> at: (index + 0.5) / root.wave.length;
                property <float> level: max(0.05, min(1, sample * sample));
                x: index * parent.width / root.wave.length;
                width: parent.width / root.wave.length + 0.6px;
                height: max(2px, parent.height * level);
                y: (parent.height - self.height) / 2;
                background: at <= root.progress ? root.played : root.idle;
            }
        }
    }

    area := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.seek-enabled;
        pointer-event(event) => {
            if (root.seek-enabled && (event.kind == PointerEventKind.down || (event.kind == PointerEventKind.move && root.dragging))) {
                root.dragging = true;
                root.seek(max(0, min(1, area.mouse-x / area.width)));
            }
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.dragging = false;
            }
        }
    }
}

export component VolumeBar inherits Rectangle {
    in property <float> volume;
    in property <bool> stretch: false;
    in property <bool> inverted: false;
    callback set-volume(float);
    horizontal-stretch: root.stretch ? 1 : 0;
    min-width: 72px;
    preferred-width: 96px;
    height: 22px;
    property <bool> dragging: false;

    Rectangle {
        y: (parent.height - 4px) / 2;
        width: 100%;
        height: 4px;
        background: root.inverted ? #00000040 : #3a3a3a;
        border-radius: 2px;

        Rectangle {
            x: 0px;
            width: parent.width * max(0, min(1, root.volume));
            height: 100%;
            background: root.inverted ? #ffffff : Theme.orange;
            border-radius: 2px;
        }
        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: root.inverted ? #ffffff : Theme.orange;
            x: (parent.width - self.width) * max(0, min(1, root.volume));
            y: (parent.height - self.height) / 2;
        }
    }

    area := TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down || (event.kind == PointerEventKind.move && root.dragging)) {
                root.dragging = true;
                root.set-volume(max(0, min(1, area.mouse-x / area.width)));
            }
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.dragging = false;
            }
        }
    }
}

component ModeChip inherits Rectangle {
    in property <string> glyph;
    in property <string> tip;
    in property <bool> active;
    callback clicked();
    width: 18px;
    height: 18px;
    border-radius: 3px;
    background: root.active ? (touch.has-hover ? #f0a04a : Theme.orange) : (touch.has-hover ? #3a3a3a : Theme.raised);

    Path {
        width: 18px;
        height: 18px;
        viewbox-width: 18;
        viewbox-height: 18;
        commands: root.glyph == "–" ? "M 5 9 L 13 9"
            : root.glyph == "☰" ? "M 5 4 L 13 4 L 13 14 L 5 14 Z M 5 8 L 13 8"
            : "M 4 4 L 14 4 L 14 14 L 4 14 Z M 7 4 L 7 14 M 11 4 L 11 14 M 4 11 L 14 11";
        fill: transparent;
        stroke: root.active ? #1b1b1b : (touch.has-hover ? Theme.text : Theme.muted);
        stroke-width: 1px;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Tooltip { text: @markdown("\{root.tip}"); }
}

export component EqButton inherits Rectangle {
    in property <string> label: "EQ";
    in property <string> icon: root.label == "♥" || root.label == "♥ альбом" ? "heart" : root.label == "нет" ? "dislike" : "";
    in property <string> tip;
    in property <bool> active;
    in property <bool> inverted: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 28px;
    min-width: 28px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 3px;
    opacity: root.enabled ? 1 : 0.4;
    background: root.active
        ? (touch.has-hover ? #333333 : #1b1b1b)
        : (touch.has-hover
            ? (root.inverted ? #ffffff55 : Theme.raised)
            : (root.inverted ? #ffffff22 : transparent));
    border-width: 1px;
    border-color: root.active
        ? Theme.orange
        : (touch.has-hover
            ? (root.inverted ? #1b1b1b : Theme.orange)
            : (root.inverted ? #1b1b1b : Theme.dim));
    property <string> shown-label: root.label == "♥" || root.label == "нет" ? "" : root.label == "♥ альбом" ? "альбом" : root.label;
    property <color> foreground: root.active || (touch.has-hover && !root.inverted)
        ? Theme.orange : (root.inverted ? #1b1b1b : Theme.text);

    pure function name-for(label: string) -> string {
        if label == "EQ" { "Эквалайзер" }
        else if label == "♥" { "Лайк" }
        else if label == "нет" { "Дизлайк" }
        else if label == "♥ альбом" { "Лайк альбома" }
        else if label == "сеть" { "Поиск в сети" }
        else if label == "вкл" { "Выключить эквалайзер" }
        else if label == "выкл" { "Включить эквалайзер" }
        else if label == "сброс" { "Сбросить эквалайзер" }
        else { label }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 5px;
        alignment: center;
        cross-axis-alignment: center;
        if root.icon != "" : Glyph {
            kind: root.icon;
            tint: root.foreground;
        }
        if root.shown-label != "" : Text {
            text: root.shown-label;
            color: root.foreground;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    property <string> shown-tip: root.tip != "" ? root.tip : root.name-for(root.label);

    Tooltip { text: @markdown("\{root.shown-tip}"); }
}

export component EqSlider inherits Rectangle {
    in property <float> gain;
    in property <string> label;
    in property <string> tip;
    callback set-gain(float);
    horizontal-stretch: 1;
    min-width: 24px;
    property <bool> dragging: false;
    property <float> shown: max(-12, min(12, root.gain));
    // 0 is the top (+12 dB). 1 is the bottom (-12 dB).
    property <float> thumb: (12 - root.shown) / 24;

    VerticalLayout {
        spacing: 2px;
        alignment: center;

        track := Rectangle {
            height: 72px;
            vertical-stretch: 0;
            width: 100%;

            Rectangle {
                x: (parent.width - 4px) / 2;
                width: 4px;
                height: 100%;
                background: #3a3a3a;
                border-radius: 2px;
            }
            Rectangle {
                y: parent.height / 2;
                width: 100%;
                height: 1px;
                background: Theme.dim;
            }
            if root.shown > 0 : Rectangle {
                x: (parent.width - 4px) / 2;
                width: 4px;
                y: parent.height * root.thumb;
                height: parent.height / 2 - self.y;
                background: Theme.orange;
            }
            if root.shown < 0 : Rectangle {
                x: (parent.width - 4px) / 2;
                width: 4px;
                y: parent.height / 2;
                height: parent.height * root.thumb - parent.height / 2;
                background: Theme.orange;
            }
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: Theme.orange;
                x: (parent.width - self.width) / 2;
                y: parent.height * root.thumb - self.height / 2;
            }

            area := TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.dragging = true;
                        root.set-gain(root.db-at(area.mouse-y, area.height));
                    } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                        root.dragging = false;
                    } else if (event.kind == PointerEventKind.move && root.dragging) {
                        root.set-gain(root.db-at(area.mouse-y, area.height));
                    }
                }
            }
        }

        Text {
            height: 14px;
            vertical-stretch: 0;
            text: root.label;
            color: Theme.muted;
            font-size: 10px;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    property <string> shown-tip: root.tip != "" ? root.tip : root.label;
    Tooltip { text: @markdown("\{root.shown-tip}"); }

    pure function db-at(y: length, span: length) -> float {
        let ratio = max(0, min(1, y / max(span, 1px)));
        12 - ratio * 24
    }
}

export component Equalizer inherits Rectangle {
    in property <bool> enabled;
    in property <float> preamp;
    in property <[float]> bands;
    callback set-enabled(bool);
    callback set-preamp(float);
    callback set-band(int, float);
    callback reset();
    height: 132px;
    background: Theme.panel;

    VerticalLayout {
        padding: 6px;
        spacing: 4px;

        HorizontalLayout {
            height: 22px;
            vertical-stretch: 0;
            spacing: 6px;
            cross-axis-alignment: center;
            EqButton {
                height: 22px;
                label: root.enabled ? "вкл" : "выкл";
                active: root.enabled;
                clicked => { root.set-enabled(!root.enabled); }
            }
            Rectangle { horizontal-stretch: 1; }
            EqButton {
                height: 22px;
                label: "сброс";
                clicked => { root.reset(); }
            }
        }

        HorizontalLayout {
            height: 94px;
            vertical-stretch: 0;
            spacing: 2px;
            EqSlider {
                label: "Пр";
                tip: "Предусиление";
                gain: root.preamp;
                set-gain(value) => { root.set-preamp(value); }
            }
            for value[index] in root.bands : EqSlider {
                label: index == 0 ? "31" : index == 1 ? "62" : index == 2 ? "125" : index == 3 ? "250" : index == 4 ? "500" : index == 5 ? "1k" : index == 6 ? "2k" : index == 7 ? "4k" : index == 8 ? "8k" : "16k";
                tip: index == 0 ? "31 Гц" : index == 1 ? "62 Гц" : index == 2 ? "125 Гц" : index == 3 ? "250 Гц" : index == 4 ? "500 Гц" : index == 5 ? "1 кГц" : index == 6 ? "2 кГц" : index == 7 ? "4 кГц" : index == 8 ? "8 кГц" : "16 кГц";
                gain: value;
                set-gain(next) => { root.set-band(index, next); }
            }
        }
    }
}

export component QueueRow inherits Rectangle {
    in property <QueueItem> item;
    callback clicked();
    height: 32px;
    background: root.item.current ? Theme.orange : (touch.has-hover ? Theme.raised : transparent);

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 8px;
        cross-axis-alignment: center;

        if root.item.number != "" : Text {
            text: root.item.number;
            color: root.item.current ? #1b1b1b : Theme.muted;
            font-size: 12px;
            min-width: 18px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Text {
            text: root.item.title;
            color: root.item.current ? #1b1b1b : Theme.text;
            font-size: 13px;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.item.duration;
            color: root.item.current ? #3a240f : Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component CatalogRow inherits Rectangle {
    in property <CatalogHit> hit;
    callback clicked();
    height: 44px;
    background: touch.has-hover ? Theme.raised : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        cross-axis-alignment: center;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: root.hit.title;
                color: Theme.text;
                font-size: 13px;
                overflow: elide;
            }
            Text {
                text: root.hit.artist == "" ? root.hit.detail : (root.hit.detail == "" ? root.hit.artist : root.hit.artist + " · " + root.hit.detail);
                color: Theme.muted;
                font-size: 11px;
                overflow: elide;
            }
        }
        Text {
            text: root.hit.action;
            color: root.hit.action == "играть" ? Theme.orange : Theme.muted;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component CoverArt inherits Rectangle {
    in property <image> cover;
    in property <bool> has-cover;
    in property <length> mark: 56px;
    background: Theme.raised;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;

    if !root.has-cover : Image {
        source: @image-url("../assets/icon.png");
        width: root.mark;
        height: root.mark;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
    }
    if root.has-cover : Image {
        source: root.cover;
        width: 100%;
        height: 100%;
        image-fit: ImageFit.cover;
    }
}

export component Heading inherits HorizontalLayout {
    in property <string> title;
    in property <string> aside;
    in property <length> title-size: 13px;
    spacing: 8px;
    padding-left: 4px;
    padding-right: 4px;
    cross-axis-alignment: center;

    Text {
        text: root.title;
        color: Theme.orange;
        font-size: root.title-size;
        font-weight: 600;
        overflow: elide;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    @children
    Text {
        text: root.aside;
        color: Theme.dim;
        font-size: 11px;
        vertical-alignment: center;
    }
}

export component EmptyNote inherits Rectangle {
    in property <string> message;
    in property <bool> error: false;
    width: 100%;
    height: 100%;
    Text {
        width: 100%;
        height: 100%;
        text: root.message;
        color: root.error ? Theme.orange : Theme.dim;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

export component ScrollPort inherits Rectangle {
    clip: true;
    width: 100%;
    height: 100%;
    vertical-stretch: 1;
    horizontal-stretch: 1;

    property <bool> overflow: flick.content-height > flick.height + 2px;
    property <float> visible-ratio: min(1, flick.height / max(flick.content-height, 1px));
    property <length> thumb-h: max(18px, flick.height * root.visible-ratio);
    property <length> travel: max(0px, flick.height - root.thumb-h);
    property <float> scrolled: max(0, min(1, (-flick.content-y) / max(flick.content-height - flick.height, 1px)));

    flick := Flickable {
        x: 0px;
        // Reserve the gutter even without overflow: wrapped text must not
        // change its width when its own height causes a scrollbar.
        width: parent.width - 7px;
        height: 100%;
        content-width: self.width;
        VerticalLayout {
            alignment: start;
            @children
        }
    }

    if root.overflow : Rectangle {
        x: parent.width - 5px;
        y: root.scrolled * root.travel;
        width: 3px;
        height: root.thumb-h;
        border-radius: 2px;
        background: #ffffff28;
    }
}

export component ModeSwitch inherits HorizontalLayout {
    in property <int> mode;
    callback set-mode(int);
    horizontal-stretch: 0;
    spacing: 3px;
    alignment: center;

    ModeChip { glyph: "–"; tip: "Компактный вид"; active: root.mode == 0; clicked => { root.set-mode(0); } }
    ModeChip { glyph: "☰"; tip: "Средний вид"; active: root.mode == 1; clicked => { root.set-mode(1); } }
    ModeChip { glyph: "▦"; tip: "Большой вид"; active: root.mode == 2; clicked => { root.set-mode(2); } }
}

export component PlaybackStatus inherits Rectangle {
    in property <string> message;
    in property <bool> busy;
    in property <bool> error;
    in property <bool> inverted: false;
    height: 16px;
    min-width: 32px;
    horizontal-stretch: 1;
    Text {
        width: 100%;
        height: 100%;
        text: (root.busy ? "… " : "") + root.message;
        color: root.error ? (root.inverted ? #691800 : Theme.orange) : (root.inverted ? #342315 : Theme.muted);
        font-size: 11px;
        vertical-alignment: center;
        overflow: elide;
    }
    Tooltip { text: @markdown("\{root.message}"); }
}
