import { LineEdit } from "std-widgets.slint";

export global Theme {
    out property <color> bg: #1b1b1b;
    out property <color> panel: #242424;
    out property <color> raised: #2c2c2c;
    out property <color> orange: #e8872a;
    out property <color> text: #f3f3f3;
    out property <color> muted: #a3a3a3;
    out property <color> dim: #6f6f6f;
}

export component SearchField inherits Rectangle {
    in-out property <string> text;
    callback edited(string);
    min-height: 32px;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    LineEdit {
        width: 100%;
        placeholder-text: "Поиск";
        text <=> root.text;
        edited(value) => { root.edited(value); }
    }
}

export component IconButton inherits Rectangle {
    in property <string> glyph;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: touch.pressed ? Theme.raised : transparent;

    Text {
        width: 100%;
        height: 100%;
        text: root.glyph;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component SeekBar inherits Rectangle {
    in property <float> position;
    in property <float> duration;
    callback seek(float);
    // The painted bar is 8px. The touch target is the whole row, so it does not spill onto the buttons.
    height: 18px;

    Rectangle {
        y: (parent.height - 8px) / 2;
        width: 100%;
        height: 8px;
        background: #3a3a3a;
        border-radius: 4px;

        Rectangle {
            width: parent.width * min(1, root.position / max(root.duration, 0.001));
            height: 100%;
            background: Theme.orange;
            border-radius: 4px;
        }
    }

    area := TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.seek(area.mouse-x / area.width);
            }
        }
    }
}

export component VolumeBar inherits Rectangle {
    in property <float> volume;
    in property <bool> stretch: false;
    callback set-volume(float);
    horizontal-stretch: root.stretch ? 1 : 0;
    min-width: 72px;
    preferred-width: 88px;
    height: 22px;

    Rectangle {
        y: (parent.height - 8px) / 2;
        width: 100%;
        height: 8px;
        background: #3a3a3a;
        border-radius: 4px;

        Rectangle {
            width: parent.width * max(0, min(1, root.volume));
            height: 100%;
            background: Theme.orange;
            border-radius: 4px;
        }
    }

    area := TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.set-volume(area.mouse-x / area.width);
            }
        }
    }
}

component ModeChip inherits Rectangle {
    in property <string> glyph;
    in property <bool> active;
    callback clicked();
    width: 18px;
    height: 18px;
    border-radius: 3px;
    background: root.active ? Theme.orange : Theme.raised;

    Text {
        width: 100%;
        height: 100%;
        text: root.glyph;
        color: root.active ? #1b1b1b : Theme.muted;
        font-size: 10px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

export component ModeSwitch inherits HorizontalLayout {
    in property <int> mode;
    callback set-mode(int);
    spacing: 3px;
    alignment: center;

    ModeChip { glyph: "–"; active: root.mode == 0; clicked => { root.set-mode(0); } }
    ModeChip { glyph: "☰"; active: root.mode == 1; clicked => { root.set-mode(1); } }
    ModeChip { glyph: "▦"; active: root.mode == 2; clicked => { root.set-mode(2); } }
}
