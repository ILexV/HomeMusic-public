import { CheckBox, ComboBox, Slider } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component AudioPanel inherits Rectangle {
    in property <float> audio-crossfade;
    in property <bool> audio-overlap-album;
    in property <int> audio-normalization;
    in property <string> audio-status;
    callback audio-set-crossfade(float);
    callback audio-set-overlap-album(bool);
    callback audio-set-normalization(int);
    background: Theme.panel;
    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        Text { text: "Звук и переходы"; color: Theme.text; font-size: 22px; font-weight: 600; }
        Text { text: "Изменения применяются сразу."; color: Theme.muted; }
        Text { text: "Плавный переход между треками"; color: Theme.text; font-size: 17px; }
        Text { text: root.audio-crossfade == 0 ? "Без перекрытия" : "Перекрытие: " + round(root.audio-crossfade * 10) / 10 + " с"; color: Theme.muted; }
        Slider {
            minimum: 0; maximum: 12; step: 0.1; value: root.audio-crossfade;
            changed(value) => { root.audio-set-crossfade(value); }
        }
        CheckBox {
            text: "Разрешить перекрытие внутри альбома";
            enabled: root.audio-crossfade > 0;
            checked: root.audio-overlap-album;
            toggled => { root.audio-set-overlap-album(self.checked); }
        }
        Rectangle { height: 1px; background: Theme.line; }
        Text { text: "Нормализация громкости"; color: Theme.text; font-size: 17px; }
        ComboBox {
            model: ["Выключена", "По треку", "По альбому"];
            current-index: root.audio-normalization;
            selected(value) => { root.audio-set-normalization(self.current-index); }
        }
        Text { text: root.audio-status; color: Theme.orange; wrap: word-wrap; }
        Text {
            text: "«По треку» выравнивает громкость песен. «По альбому» сохраняет разницу между ними. Без тегов громкости плеер анализирует запись в фоне.";
            color: Theme.muted; wrap: word-wrap;
        }
        Rectangle { vertical-stretch: 1; }
    }
}
