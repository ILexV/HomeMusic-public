import { CoverArt, Glyph, PlaybackActions, PlaybackStatus, SeekBar, Theme, TransportButton, VolumeBar } from "theme.slint";

export component Mini inherits Rectangle {
    in property <string> track-title;
    in property <string> track-artist;
    in property <image> cover;
    in property <bool> has-cover;
    in property <string> time-label;
    in property <string> duration-label;
    in property <float> position;
    in property <float> duration;
    in property <float> volume;
    in property <[float]> wave;
    in property <string> wave-message;
    in property <bool> playing;
    in property <string> playback-message;
    in property <bool> playback-busy;
    in property <bool> playback-error;
    in property <bool> seek-enabled;
    in property <bool> eq-on;
    in property <bool> liked;
    in property <bool> disliked;
    callback play-pause();
    callback stop();
    callback prev();
    callback next();
    callback seek(float);
    callback set-volume(float);
    callback toggle-eq();
    callback toggle-like();
    callback toggle-dislike();

    background: Theme.bg;

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 4px;

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 10px;

            CoverArt {
                width: 64px;
                height: self.width;
                mark: 24px;
                cover: root.cover;
                has-cover: root.has-cover;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;

                HorizontalLayout {
                    height: 18px;
                    spacing: 8px;
                    Text {
                        text: root.track-title;
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if root.track-artist != "" : Text {
                        text: root.track-artist;
                        color: Theme.muted;
                        font-size: 12px;
                        overflow: elide;
                        vertical-alignment: center;
                        max-width: 120px;
                    }
                    Text {
                        text: root.time-label + " / " + root.duration-label;
                        color: Theme.muted;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                }
                if root.playback-message != "" : PlaybackStatus {
                    message: root.playback-message;
                    busy: root.playback-busy;
                    error: root.playback-error;
                }
                Rectangle {
                    min-height: 24px;
                    vertical-stretch: 1;
                    SeekBar {
                        width: 100%;
                        bar-height: parent.height;
                        position: root.position;
                        duration: root.duration;
                        wave: root.wave;
                        wave-message: root.wave-message;
                        seek-enabled: root.seek-enabled;
                        seek(ratio) => { root.seek(ratio); }
                    }
                }
            }
        }

        HorizontalLayout {
            height: 40px;
            vertical-stretch: 0;
            spacing: 8px;
            cross-axis-alignment: center;

            HorizontalLayout {
                spacing: 2px;
                horizontal-stretch: 0;
                cross-axis-alignment: center;
                TransportButton { kind: "prev"; clicked => { root.prev(); } }
                TransportButton {
                    kind: root.playing ? "pause" : "play";
                    primary: true;
                    clicked => { root.play-pause(); }
                }
                TransportButton { kind: "stop"; clicked => { root.stop(); } }
                TransportButton { kind: "next"; clicked => { root.next(); } }
            }
            Rectangle { horizontal-stretch: 1; }
            PlaybackActions {
                liked: root.liked;
                disliked: root.disliked;
                eq-on: root.eq-on;
                toggle-like => { root.toggle-like(); }
                toggle-dislike => { root.toggle-dislike(); }
                toggle-eq => { root.toggle-eq(); }
            }
            Rectangle { horizontal-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 0;
                cross-axis-alignment: center;
                Glyph { kind: "speaker"; tint: Theme.muted; }
                VolumeBar {
                    width: 96px;
                    volume: root.volume;
                    set-volume(value) => { root.set-volume(value); }
                }
            }
        }
    }
}
