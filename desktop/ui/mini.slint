import { IconButton, ModeSwitch, SeekBar, Theme, VolumeBar } from "theme.slint";

export component Mini inherits Rectangle {
    in property <string> track-title;
    in property <string> track-artist;
    in property <string> error;
    in property <string> time-label;
    in property <string> duration-label;
    in property <float> position;
    in property <float> duration;
    in property <float> volume;
    in property <[float]> wave;
    in property <bool> playing;
    in property <int> mode;
    callback play-pause();
    callback stop();
    callback next();
    callback seek(float);
    callback set-volume(float);
    callback set-mode(int);

    background: Theme.bg;

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 8px;
            alignment: center;

            if root.track-artist != "" : Text {
                text: root.track-artist;
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
                max-width: 150px;
            }
            Text {
                text: root.track-title;
                color: Theme.text;
                font-size: 13px;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: root.time-label + " / " + root.duration-label;
                color: Theme.muted;
                font-size: 12px;
                vertical-alignment: center;
            }
            ModeSwitch {
                mode: root.mode;
                set-mode(mode) => { root.set-mode(mode); }
            }
        }

        SeekBar {
            position: root.position;
            duration: root.duration;
            wave: root.wave;
            seek(ratio) => { root.seek(ratio); }
        }

        HorizontalLayout {
            spacing: 4px;
            alignment: center;

            VolumeBar {
                stretch: true;
                volume: root.volume;
                set-volume(value) => { root.set-volume(value); }
            }
            IconButton { glyph: root.playing ? "⏸" : "▶"; clicked => { root.play-pause(); } }
            IconButton { glyph: "⏹"; clicked => { root.stop(); } }
            IconButton { glyph: "⏭"; clicked => { root.next(); } }
        }

        if root.error != "" : Text {
            text: root.error;
            color: Theme.orange;
            font-size: 12px;
            overflow: elide;
        }
    }
}
