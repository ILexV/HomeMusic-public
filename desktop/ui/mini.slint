import { EqButton, Glyph, SeekBar, Theme, TransportButton, VolumeBar } from "theme.slint";

export component Mini inherits Rectangle {
    in property <string> track-title;
    in property <string> track-artist;
    in property <string> time-label;
    in property <string> duration-label;
    in property <float> position;
    in property <float> duration;
    in property <float> volume;
    in property <[float]> wave;
    in property <bool> playing;
    in property <bool> eq-on;
    in property <bool> liked;
    in property <bool> disliked;
    callback play-pause();
    callback stop();
    callback prev();
    callback next();
    callback seek(float);
    callback set-volume(float);
    callback toggle-eq();
    callback toggle-like();
    callback toggle-dislike();

    background: Theme.bg;

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 6px;
        alignment: center;

        HorizontalLayout {
            height: 22px;
            vertical-stretch: 0;
            spacing: 10px;
            cross-axis-alignment: center;

            Text {
                text: root.track-title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.track-artist != "" : Text {
                text: root.track-artist;
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
                max-width: 140px;
                horizontal-stretch: 0;
            }
            Text {
                text: root.time-label + " / " + root.duration-label;
                color: Theme.muted;
                font-size: 11px;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
        }

        SeekBar {
            bar-height: 32px;
            vertical-stretch: 0;
            position: root.position;
            duration: root.duration;
            wave: root.wave;
            seek(ratio) => { root.seek(ratio); }
        }

        HorizontalLayout {
            height: 40px;
            vertical-stretch: 0;
            spacing: 8px;
            cross-axis-alignment: center;

            HorizontalLayout {
                spacing: 2px;
                horizontal-stretch: 0;
                cross-axis-alignment: center;
                TransportButton { kind: "prev"; clicked => { root.prev(); } }
                TransportButton {
                    kind: root.playing ? "pause" : "play";
                    primary: true;
                    clicked => { root.play-pause(); }
                }
                TransportButton { kind: "stop"; clicked => { root.stop(); } }
                TransportButton { kind: "next"; clicked => { root.next(); } }
            }
            Rectangle { horizontal-stretch: 1; }
            HorizontalLayout {
                spacing: 4px;
                horizontal-stretch: 0;
                cross-axis-alignment: center;
                EqButton { label: "♥"; active: root.liked; clicked => { root.toggle-like(); } }
                EqButton { label: "нет"; active: root.disliked; clicked => { root.toggle-dislike(); } }
                EqButton { active: root.eq-on; clicked => { root.toggle-eq(); } }
            }
            Rectangle { horizontal-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 0;
                cross-axis-alignment: center;
                Glyph { kind: "speaker"; tint: Theme.muted; }
                VolumeBar {
                    width: 96px;
                    volume: root.volume;
                    set-volume(value) => { root.set-volume(value); }
                }
            }
        }
    }
}
