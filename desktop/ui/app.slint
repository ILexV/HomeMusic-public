import { Large } from "large.slint";
import { Medium } from "medium.slint";
import { Mini } from "mini.slint";
import { Equalizer, ModeSwitch, Theme, TitleButton } from "theme.slint";

import { AlbumItem, ArtistItem, CatalogHit, HomeRow, QueueItem } from "types.slint";

export enum Mode { mini, medium, large }

export component AppWindow inherits Window {
    title: "HomeMusic";
    icon: @image-url("../assets/icon.png");
    background: Theme.bg;
    default-font-size: 14px;
    no-frame: true;
    always-on-top: root.mode == Mode.mini;
    resize-border-width: 6px;
    forward-focus: keys;

    in-out property <Mode> mode: Mode.mini;
    property <int> mode-index: root.mode == Mode.mini ? 0 : root.mode == Mode.medium ? 1 : 2;
    in-out property <string> track-title;
    in-out property <string> track-artist;
    in-out property <string> track-album;
    in-out property <string> track-meta;
    in-out property <string> time-label;
    in-out property <string> duration-label;
    in-out property <string> status;
    in-out property <string> error;
    in-out property <image> cover;
    in-out property <bool> has-cover: false;
    in-out property <float> position;
    in-out property <float> duration;
    in-out property <float> volume;
    in-out property <[float]> wave;
    in-out property <bool> eq-on;
    in-out property <bool> eq-open;
    in-out property <float> preamp;
    in-out property <[float]> bands;
    in-out property <bool> playing;
    in-out property <[QueueItem]> queue;
    in-out property <string> queue-title: "Очередь";
    in-out property <string> queue-total;
    in-out property <[ArtistItem]> artists;
    in-out property <[AlbumItem]> albums;
    in-out property <string> search;
    in-out property <bool> liked;
    in-out property <bool> disliked;
    in-out property <bool> album-known;
    in-out property <bool> album-liked;
    in-out property <bool> catalog-open;
    in-out property <string> catalog-note: "Поиск в сети";
    in-out property <[CatalogHit]> hits;
    in-out property <bool> home-open: true;
    in-out property <string> home-title;
    in-out property <[HomeRow]> home-rows;

    callback play-pause();
    callback stop();
    callback prev();
    callback next();
    callback play-row(int);
    callback seek(float);
    callback set-volume(float);
    callback set-mode(int);
    callback toggle-eq();
    callback set-eq-enabled(bool);
    callback set-preamp(float);
    callback set-band(int, float);
    callback reset-eq();
    callback search-edited(string);
    callback pick-artist(int);
    callback open-album(int);
    callback toggle-like();
    callback toggle-dislike();
    callback toggle-album-like();
    callback toggle-catalog();
    callback pick-hit(int);
    callback star-album(int);
    callback show-home();
    callback show-library();
    callback pick-home(int);
    callback minimize();
    callback close-window();
    // text, control, alt, shift, meta. True when the player handled the key.
    callback shortcut(string, bool, bool, bool, bool) -> bool;

    keys := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if (root.shortcut(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta)) {
                accept
            } else {
                reject
            }
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.bg;
            border-width: 1px;
            border-color: Theme.orange;

            VerticalLayout {
                Rectangle {
                    height: 28px;
                    background: Theme.panel;

                    WindowMoveArea {
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 2px;
                            spacing: 8px;
                            cross-axis-alignment: center;

                            HorizontalLayout {
                                spacing: 6px;
                                cross-axis-alignment: center;
                                Image {
                                    source: @image-url("../assets/icon.png");
                                    width: 16px;
                                    height: 16px;
                                }
                                Text {
                                    text: "HomeMusic";
                                    color: Theme.text;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: root.error != "" ? root.error : root.status;
                                color: root.error != "" ? Theme.orange : Theme.dim;
                                font-size: 11px;
                                overflow: elide;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            ModeSwitch {
                                mode: root.mode-index;
                                set-mode(mode) => { root.set-mode(mode); }
                            }
                            TitleButton { glyph: "–"; tip: "Свернуть"; clicked => { root.minimize(); } }
                            TitleButton { glyph: "×"; tip: "Закрыть"; clicked => { root.close-window(); } }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    clip: true;

                    if root.mode == Mode.mini : Mini {
                        width: 100%;
                        height: 100%;
                        track-title: root.track-title;
                        track-artist: root.track-artist;
                        time-label: root.time-label;
                        duration-label: root.duration-label;
                        position: root.position;
                        duration: root.duration;
                        volume: root.volume;
                        wave: root.wave;
                        playing: root.playing;
                        play-pause => { root.play-pause(); }
                        stop => { root.stop(); }
                        prev => { root.prev(); }
                        next => { root.next(); }
                        seek(ratio) => { root.seek(ratio); }
                        set-volume(value) => { root.set-volume(value); }
                        eq-on: root.eq-on;
                        toggle-eq => { root.toggle-eq(); }
                        liked: root.liked;
                        disliked: root.disliked;
                        toggle-like => { root.toggle-like(); }
                        toggle-dislike => { root.toggle-dislike(); }
                    }
                    if root.mode == Mode.medium : Medium {
                        width: 100%;
                        height: 100%;
                        track-title: root.track-title;
                        track-artist: root.track-artist;
                        track-album: root.track-album;
                        track-meta: root.track-meta;
                        cover: root.cover;
                        has-cover: root.has-cover;
                        time-label: root.time-label;
                        duration-label: root.duration-label;
                        position: root.position;
                        duration: root.duration;
                        volume: root.volume;
                        wave: root.wave;
                        playing: root.playing;
                        queue: root.queue;
                        queue-title: root.queue-title;
                        queue-total: root.queue-total;
                        search <=> root.search;
                        play-pause => { root.play-pause(); }
                        stop => { root.stop(); }
                        prev => { root.prev(); }
                        next => { root.next(); }
                        play-row(index) => { root.play-row(index); }
                        seek(ratio) => { root.seek(ratio); }
                        set-volume(value) => { root.set-volume(value); }
                        search-edited(text) => { root.search-edited(text); }
                        eq-on: root.eq-on;
                        toggle-eq => { root.toggle-eq(); }
                        liked: root.liked;
                        disliked: root.disliked;
                        album-known: root.album-known;
                        album-liked: root.album-liked;
                        catalog-open: root.catalog-open;
                        catalog-note: root.catalog-note;
                        hits: root.hits;
                        toggle-like => { root.toggle-like(); }
                        toggle-dislike => { root.toggle-dislike(); }
                        toggle-album-like => { root.toggle-album-like(); }
                        toggle-catalog => { root.toggle-catalog(); }
                        pick-hit(index) => { root.pick-hit(index); }
                    }
                    if root.mode == Mode.large : Large {
                        width: 100%;
                        height: 100%;
                        track-title: root.track-title;
                        track-artist: root.track-artist;
                        track-album: root.track-album;
                        track-meta: root.track-meta;
                        time-label: root.time-label;
                        duration-label: root.duration-label;
                        position: root.position;
                        duration: root.duration;
                        volume: root.volume;
                        wave: root.wave;
                        playing: root.playing;
                        queue: root.queue;
                        queue-title: root.queue-title;
                        queue-total: root.queue-total;
                        artists: root.artists;
                        albums: root.albums;
                        search <=> root.search;
                        cover: root.cover;
                        has-cover: root.has-cover;
                        play-pause => { root.play-pause(); }
                        stop => { root.stop(); }
                        prev => { root.prev(); }
                        next => { root.next(); }
                        play-row(index) => { root.play-row(index); }
                        seek(ratio) => { root.seek(ratio); }
                        set-volume(value) => { root.set-volume(value); }
                        search-edited(text) => { root.search-edited(text); }
                        pick-artist(index) => { root.pick-artist(index); }
                        open-album(index) => { root.open-album(index); }
                        eq-on: root.eq-on;
                        toggle-eq => { root.toggle-eq(); }
                        liked: root.liked;
                        disliked: root.disliked;
                        album-known: root.album-known;
                        album-liked: root.album-liked;
                        catalog-open: root.catalog-open;
                        catalog-note: root.catalog-note;
                        hits: root.hits;
                        toggle-like => { root.toggle-like(); }
                        toggle-dislike => { root.toggle-dislike(); }
                        toggle-album-like => { root.toggle-album-like(); }
                        toggle-catalog => { root.toggle-catalog(); }
                        pick-hit(index) => { root.pick-hit(index); }
                        star-album(index) => { root.star-album(index); }
                        home-open: root.home-open;
                        home-title: root.home-title;
                        home-rows: root.home-rows;
                        show-home => { root.show-home(); }
                        show-library => { root.show-library(); }
                        pick-home(index) => { root.pick-home(index); }
                    }
                }

                if root.eq-open : Equalizer {
                    enabled: root.eq-on;
                    preamp: root.preamp;
                    bands: root.bands;
                    set-enabled(on) => { root.set-eq-enabled(on); }
                    set-preamp(value) => { root.set-preamp(value); }
                    set-band(index, value) => { root.set-band(index, value); }
                    reset => { root.reset-eq(); }
                }
            }
        }
    }
}

export component PlayerTray inherits SystemTrayIcon {
    in-out property <image> tray-icon;
    icon: root.tray-icon;
    tooltip: "HomeMusic";
    title: "HomeMusic";
    callback show-window();
    callback quit();
    callback icon-clicked();
    clicked => { root.icon-clicked(); }

    Menu {
        MenuItem {
            title: "Показать";
            activated => { root.show-window(); }
        }
        MenuItem {
            title: "Выход";
            activated => { root.quit(); }
        }
    }
}
