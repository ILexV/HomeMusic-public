import { CatalogRow, CoverArt, EmptyNote, EqButton, Glyph, Heading, PlaybackStatus, ScrollPort, SearchField, SeekBar, Theme, TransportButton, VolumeBar } from "theme.slint";
import { AlbumDetail } from "album.slint";
import { QueueView } from "queue.slint";
import { CatalogHit, QueueItem } from "types.slint";

export component Medium inherits Rectangle {
    in property <string> track-title;
    in property <string> track-artist;
    in property <string> track-album;
    in property <string> track-meta;
    in property <image> cover;
    in property <bool> has-cover;
    in property <string> time-label;
    in property <string> duration-label;
    in property <float> position;
    in property <float> duration;
    in property <float> volume;
    in property <[float]> wave;
    in property <string> wave-message;
    in property <bool> playing;
    in property <bool> eq-on;
    in property <bool> liked;
    in property <bool> disliked;
    in property <bool> album-known;
    in property <bool> album-liked;
    in property <bool> catalog-open;
    in property <string> catalog-note;
    in property <[CatalogHit]> hits;
    in property <[QueueItem]> queue;
    in property <string> queue-title;
    in property <string> queue-total;
    in-out property <string> search;
    in-out property <string> queue-search;
    in property <bool> queue-busy;
    in property <string> queue-error;
    in property <bool> catalog-busy;
    in property <string> playback-message;
    in property <bool> playback-busy;
    in property <bool> playback-error;
    in property <bool> seek-enabled;
    in property <bool> album-open;
    in property <string> album-title;
    in property <string> album-artist;
    in property <image> album-cover;
    in property <bool> album-has-cover;
    in property <[QueueItem]> album-tracks;
    in property <string> album-total;
    in property <bool> album-busy;
    in property <string> album-error;
    in property <string> album-note;
    callback queue-search-edited(string);
    callback move-queue-row(int, int);
    callback remove-queue-row(int);
    callback queue-row-next(int);
    callback close-album();
    callback album-play();
    callback album-enqueue();
    callback album-play-row(int);
    callback play-pause();
    callback stop();
    callback prev();
    callback next();
    callback play-row(int);
    callback search-edited(string);
    callback seek(float);
    callback set-volume(float);
    callback toggle-eq();
    callback toggle-like();
    callback toggle-dislike();
    callback toggle-album-like();
    callback toggle-catalog();
    callback pick-hit(int);
    callback download-hit(int);

    background: Theme.bg;

    VerticalLayout {
        Rectangle {
            height: 258px;
            vertical-stretch: 0;
            background: Theme.panel;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                HorizontalLayout {
                    height: 112px;
                    vertical-stretch: 0;
                    spacing: 14px;
                    cross-axis-alignment: center;

                    CoverArt {
                        width: 112px;
                        height: 112px;
                        horizontal-stretch: 0;
                        vertical-stretch: 0;
                        cover: root.cover;
                        has-cover: root.has-cover;
                        mark: 56px;
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 5px;
                        alignment: center;

                        Text {
                            text: root.track-title;
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text { text: root.track-artist; color: Theme.muted; font-size: 13px; overflow: elide; }
                        Text { text: root.track-album; color: Theme.dim; font-size: 12px; overflow: elide; }
                        Text { text: root.track-meta; color: Theme.dim; font-size: 11px; overflow: elide; }
                        PlaybackStatus { message: root.playback-message; busy: root.playback-busy; error: root.playback-error; }
                    }
                }

                HorizontalLayout {
                    height: 40px;
                    vertical-stretch: 0;
                    spacing: 8px;
                    cross-axis-alignment: center;

                    HorizontalLayout {
                        spacing: 2px;
                        horizontal-stretch: 0;
                        cross-axis-alignment: center;
                        TransportButton { kind: "prev"; clicked => { root.prev(); } }
                        TransportButton {
                            kind: root.playing ? "pause" : "play";
                            primary: true;
                            clicked => { root.play-pause(); }
                        }
                        TransportButton { kind: "stop"; clicked => { root.stop(); } }
                        TransportButton { kind: "next"; clicked => { root.next(); } }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    HorizontalLayout {
                        spacing: 4px;
                        horizontal-stretch: 0;
                        cross-axis-alignment: center;
                        EqButton { label: "♥"; active: root.liked; clicked => { root.toggle-like(); } }
                        EqButton { label: "нет"; active: root.disliked; clicked => { root.toggle-dislike(); } }
                        EqButton { active: root.eq-on; clicked => { root.toggle-eq(); } }
                    }
                }

                SeekBar {
                    bar-height: 32px;
                    vertical-stretch: 0;
                    position: root.position;
                    duration: root.duration;
                    wave: root.wave;
                    wave-message: root.wave-message;
                    seek-enabled: root.seek-enabled;
                    seek(ratio) => { root.seek(ratio); }
                }

                HorizontalLayout {
                    height: 22px;
                    vertical-stretch: 0;
                    spacing: 8px;
                    cross-axis-alignment: center;
                    Text {
                        text: root.time-label + " / " + root.duration-label;
                        color: Theme.muted;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Glyph { kind: "speaker"; tint: Theme.muted; }
                    VolumeBar {
                        width: 96px;
                        volume: root.volume;
                        set-volume(value) => { root.set-volume(value); }
                    }
                }
            }
        }

        VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 6px;
            vertical-stretch: 1;

            if !root.album-open : Heading {
                height: 36px;
                vertical-stretch: 0;
                title: root.catalog-open ? root.catalog-note : root.queue-title;
                if root.album-known && !root.catalog-open : EqButton {
                    label: "♥ альбом";
                    active: root.album-liked;
                    clicked => { root.toggle-album-like(); }
                }
            }

            if !root.album-open : Rectangle {
                vertical-stretch: 1;
                min-height: 48px;
                preferred-height: 48px;

                if !root.catalog-open : QueueView {
                    width: 100%; height: 100%;
                    queue: root.queue;
                    busy: root.queue-busy;
                    error: root.queue-error;
                    filtered: root.queue-search != "";
                    play-row(index) => { root.play-row(index); }
                    move-queue-row(from, to) => { root.move-queue-row(from, to); }
                    remove-queue-row(index) => { root.remove-queue-row(index); }
                    queue-row-next(index) => { root.queue-row-next(index); }
                }
                if root.catalog-open && root.catalog-busy : EmptyNote { message: "Поиск в сети…"; }
                if root.catalog-open && !root.catalog-busy && root.hits.length == 0 : EmptyNote { message: root.catalog-note; }
                if root.catalog-open && !root.catalog-busy && root.hits.length > 0 : ScrollPort {
                    for hit[index] in root.hits : CatalogRow {
                        hit: hit;
                        clicked => { root.pick-hit(index); }
                        download => { root.download-hit(index); }
                    }
                }
            }
            if root.album-open : AlbumDetail {
                compact: true;
                album-title: root.album-title;
                album-artist: root.album-artist;
                album-cover: root.album-cover;
                album-has-cover: root.album-has-cover;
                album-tracks: root.album-tracks;
                album-total: root.album-total;
                album-busy: root.album-busy;
                album-error: root.album-error;
                album-note: root.album-note;
                close-album => { root.close-album(); }
                album-play => { root.album-play(); }
                album-enqueue => { root.album-enqueue(); }
                album-play-row(index) => { root.album-play-row(index); }
            }
        }

        if !root.catalog-open && !root.album-open : HorizontalLayout {
            height: 28px;
            vertical-stretch: 0;
            padding-left: 14px;
            padding-right: 14px;
            cross-axis-alignment: center;
            Text {
                text: root.queue-total;
                color: Theme.dim;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 46px;
            vertical-stretch: 0;
            background: Theme.orange;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                cross-axis-alignment: center;
                EqButton {
                    label: "сеть";
                    inverted: true;
                    active: root.catalog-open;
                    clicked => { root.toggle-catalog(); }
                }
                if root.catalog-open : SearchField {
                    hint: "Поиск в сети";
                    text <=> root.search;
                    edited(text) => { root.search-edited(text); }
                }
                if !root.catalog-open : SearchField {
                    hint: "Фильтр очереди";
                    text <=> root.queue-search;
                    edited(text) => { root.queue-search-edited(text); }
                }
            }
        }
    }
}
