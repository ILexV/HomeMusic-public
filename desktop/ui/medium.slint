import { CatalogRow, CoverArt, EmptyNote, EqButton, Glyph, Heading, QueueRow, ScrollPort, SearchField, SeekBar, Theme, TransportButton, VolumeBar } from "theme.slint";
import { CatalogHit, QueueItem } from "types.slint";

export component Medium inherits Rectangle {
    in property <string> track-title;
    in property <string> track-artist;
    in property <string> track-album;
    in property <string> track-meta;
    in property <image> cover;
    in property <bool> has-cover;
    in property <string> time-label;
    in property <string> duration-label;
    in property <float> position;
    in property <float> duration;
    in property <float> volume;
    in property <[float]> wave;
    in property <bool> playing;
    in property <bool> eq-on;
    in property <bool> liked;
    in property <bool> disliked;
    in property <bool> album-known;
    in property <bool> album-liked;
    in property <bool> catalog-open;
    in property <string> catalog-note;
    in property <[CatalogHit]> hits;
    in property <[QueueItem]> queue;
    in property <string> queue-title;
    in property <string> queue-total;
    in-out property <string> search;
    callback play-pause();
    callback stop();
    callback prev();
    callback next();
    callback play-row(int);
    callback search-edited(string);
    callback seek(float);
    callback set-volume(float);
    callback toggle-eq();
    callback toggle-like();
    callback toggle-dislike();
    callback toggle-album-like();
    callback toggle-catalog();
    callback pick-hit(int);

    background: Theme.bg;

    VerticalLayout {
        Rectangle {
            background: Theme.panel;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 12px;

                    CoverArt {
                        width: 104px;
                        height: 104px;
                        cover: root.cover;
                        has-cover: root.has-cover;
                        mark: 52px;
                    }

                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;

                        Text {
                            text: root.track-title;
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text { text: root.track-artist; color: Theme.muted; font-size: 13px; overflow: elide; }
                        Text { text: root.track-album; color: Theme.dim; font-size: 12px; overflow: elide; }
                        Text { text: root.track-meta; color: Theme.dim; font-size: 11px; overflow: elide; }
                    }
                }

                HorizontalLayout {
                    spacing: 2px;
                    alignment: center;
                    TransportButton { kind: "prev"; clicked => { root.prev(); } }
                    TransportButton {
                        kind: root.playing ? "pause" : "play";
                        primary: true;
                        clicked => { root.play-pause(); }
                    }
                    TransportButton { kind: "stop"; clicked => { root.stop(); } }
                    TransportButton { kind: "next"; clicked => { root.next(); } }
                    EqButton { label: "♥"; active: root.liked; clicked => { root.toggle-like(); } }
                    EqButton { label: "нет"; active: root.disliked; clicked => { root.toggle-dislike(); } }
                    EqButton { active: root.eq-on; clicked => { root.toggle-eq(); } }
                }
            }
        }

        SeekBar {
            bar-height: 36px;
            position: root.position;
            duration: root.duration;
            wave: root.wave;
            seek(ratio) => { root.seek(ratio); }
        }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 8px;
            cross-axis-alignment: center;
            Text { text: root.time-label; color: Theme.muted; font-size: 11px; }
            Rectangle { horizontal-stretch: 1; }
            Glyph { kind: "speaker"; tint: Theme.muted; }
            VolumeBar {
                volume: root.volume;
                set-volume(value) => { root.set-volume(value); }
            }
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.duration-label; color: Theme.muted; font-size: 11px; }
        }

        VerticalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 6px;
            vertical-stretch: 1;

            Heading {
                title: root.catalog-open ? root.catalog-note : root.queue-title;
                aside: root.catalog-open ? "" : root.queue-total;
                if root.album-known && !root.catalog-open : EqButton {
                    label: "♥ альбом";
                    active: root.album-liked;
                    clicked => { root.toggle-album-like(); }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                min-height: 48px;
                preferred-height: 48px;

                if !root.catalog-open && root.queue.length == 0 : EmptyNote { message: "Очередь пуста"; }
                if root.catalog-open && root.hits.length == 0 : EmptyNote { message: "Ничего не найдено"; }
                if !root.catalog-open && root.queue.length > 0 : ScrollPort {
                    for item in root.queue : QueueRow {
                        item: item;
                        clicked => { root.play-row(item.source); }
                    }
                }
                if root.catalog-open && root.hits.length > 0 : ScrollPort {
                    for hit[index] in root.hits : CatalogRow {
                        hit: hit;
                        clicked => { root.pick-hit(index); }
                    }
                }
            }
        }

        Rectangle {
            height: 46px;
            background: Theme.orange;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                cross-axis-alignment: center;
                EqButton {
                    label: "сеть";
                    inverted: true;
                    active: root.catalog-open;
                    clicked => { root.toggle-catalog(); }
                }
                SearchField {
                    hint: root.catalog-open ? "Поиск в сети" : "Поиск";
                    text <=> root.search;
                    edited(text) => { root.search-edited(text); }
                }
            }
        }
    }
}
