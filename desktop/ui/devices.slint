import { Button, Slider } from "std-widgets.slint";
import { Theme, ScrollPort } from "theme.slint";

export struct DeviceRow {
    id: string,
    name: string,
    detail: string,
    online: bool,
    owner: bool,
}

export component DevicesPanel inherits Rectangle {
    in property <[DeviceRow]> rows;
    in property <string> status;
    in property <string> error;
    in property <string> track;
    in property <bool> busy;
    in property <bool> playing;
    in property <bool> has-session;
    in property <bool> detached;
    in property <float> position;
    in property <float> duration;
    in property <float> volume;
    callback transfer(string);
    callback take-here();
    callback local-only();
    callback command(string, float);
    background: Theme.panel;
    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        Text { text: "Устройства и общая очередь"; color: Theme.text; font-size: 18px; }
        Text { text: root.status; color: Theme.muted; wrap: word-wrap; }
        if root.error != "" : Text { text: root.error; color: Theme.orange; wrap: word-wrap; }
        Text { text: root.track; color: Theme.text; overflow: elide; }
        HorizontalLayout {
            spacing: 6px;
            Button { text: root.detached ? "Подключиться к сессии" : "Играть здесь"; enabled: !root.busy; clicked => { root.take-here(); } }
            Button { text: "Назад"; enabled: root.has-session && !root.busy; clicked => { root.command("prev", 0); } }
            Button { text: root.playing ? "Пауза" : "Играть"; enabled: root.has-session && !root.busy; clicked => { root.command(root.playing ? "pause" : "play", 0); } }
            Button { text: "Далее"; enabled: root.has-session && !root.busy; clicked => { root.command("next", 0); } }
        }
        if !root.detached : Button { text: "Отключиться от общей сессии"; clicked => { root.local-only(); } }
        if root.has-session : Text { text: "Позиция: " + round(root.position) + " / " + round(root.duration) + " с"; color: Theme.muted; }
        if root.has-session : Slider {
            accessible-label: "Позиция общей очереди";
            minimum: 0; maximum: max(1, root.duration); value: root.position;
            enabled: !root.busy && root.duration > 0;
            released(value) => { root.command("seek", value); }
        }
        if root.has-session : HorizontalLayout {
            spacing: 8px;
            Text { text: "Громкость"; color: Theme.muted; vertical-alignment: center; }
            Slider {
                accessible-label: "Громкость общей очереди";
                minimum: 0; maximum: 1; step: 0.05; value: root.volume;
                enabled: !root.busy;
                released(value) => { root.command("volume", value); }
            }
        }
        if !root.detached : Rectangle {
            vertical-stretch: 1;
            min-height: 80px;
        ScrollPort {
            for device in root.rows : Rectangle {
                height: 66px;
                background: device.owner ? Theme.raised : transparent;
                HorizontalLayout {
                    padding: 8px; spacing: 8px;
                    VerticalLayout {
                        Text { text: device.name; color: device.online ? Theme.text : Theme.dim; overflow: elide; }
                        Text { text: device.detail; color: Theme.muted; font-size: 13px; overflow: elide; }
                    }
                    Button { text: device.owner ? "Активно" : "Передать"; enabled: device.online && !device.owner && root.has-session && !root.busy; clicked => { root.transfer(device.id); } }
                }
            }
        }
        }
        Text { text: "Локальные файлы без ID библиотеки передать нельзя. При потере связи общая сессия приостанавливается."; color: Theme.dim; font-size: 13px; wrap: word-wrap; }
    }
}
