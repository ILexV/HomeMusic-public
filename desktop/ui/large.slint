import { IconButton, ModeSwitch, SearchField, SeekBar, Theme, VolumeBar } from "theme.slint";
import { AlbumItem, ArtistItem, QueueItem } from "types.slint";

export component Large inherits Rectangle {
    in property <string> track-title;
    in property <string> track-artist;
    in property <string> track-album;
    in property <string> track-meta;
    in property <image> cover;
    in property <bool> has-cover;
    in property <string> time-label;
    in property <string> duration-label;
    in property <string> status;
    in property <float> position;
    in property <float> duration;
    in property <float> volume;
    in property <bool> playing;
    in property <int> mode;
    in property <[QueueItem]> queue;
    in property <string> queue-title;
    in property <string> queue-total;
    in property <[ArtistItem]> artists;
    in property <[AlbumItem]> albums;
    in-out property <string> search;
    callback play-pause();
    callback stop();
    callback prev();
    callback next();
    callback play-row(int);
    callback seek(float);
    callback set-volume(float);
    callback set-mode(int);
    callback search-edited(string);
    callback pick-artist(int);
    callback open-album(int);

    background: Theme.bg;

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;

            VerticalLayout {
                width: 250px;
                padding: 12px;
                spacing: 8px;
                Rectangle {
                    height: 160px;
                    background: Theme.raised;
                    if root.has-cover : Image {
                        source: root.cover;
                        width: 100%;
                        height: 100%;
                        image-fit: ImageFit.cover;
                    }
                }
                Text { text: root.track-title; color: Theme.text; font-size: 15px; overflow: elide; wrap: word-wrap; }
                Text { text: root.track-artist; color: Theme.muted; font-size: 13px; overflow: elide; }
                Text { text: root.track-album; color: Theme.dim; font-size: 12px; overflow: elide; }
                Text { text: root.track-meta; color: Theme.dim; font-size: 11px; }
                Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        for item in root.queue: Rectangle {
                            height: 20px;
                            Text {
                                text: item.title;
                                color: item.current ? Theme.orange : Theme.muted;
                                font-size: 12px;
                                overflow: elide;
                                width: 100%;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.play-row(item.source); }
                            }
                        }
                    }
                }
            }

            Rectangle { width: 1px; background: #333; }

            VerticalLayout {
                horizontal-stretch: 1;
                padding: 12px;
                spacing: 8px;
                Text { text: "Библиотека"; color: Theme.text; font-size: 14px; }
                SearchField {
                    text <=> root.search;
                    edited(text) => { root.search-edited(text); }
                }
                HorizontalLayout {
                    spacing: 8px;
                    vertical-stretch: 1;

                    VerticalLayout {
                        width: 150px;
                        spacing: 4px;
                        Text { text: "Исполнители"; color: Theme.muted; font-size: 12px; }
                        Flickable {
                            vertical-stretch: 1;
                            VerticalLayout {
                                for artist[index] in root.artists: Rectangle {
                                    height: 28px;
                                    background: artist.current ? Theme.orange : transparent;
                                    Text {
                                        text: artist.name;
                                        color: artist.current ? #1b1b1b : Theme.text;
                                        font-size: 12px;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        x: 6px;
                                        width: parent.width - 12px;
                                    }
                                    TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        clicked => { root.pick-artist(index); }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { width: 1px; background: #333; }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        Text { text: "Альбомы"; color: Theme.muted; font-size: 12px; }
                        Flickable {
                            vertical-stretch: 1;
                            VerticalLayout {
                                for album[index] in root.albums: Rectangle {
                                    height: 40px;
                                    VerticalLayout {
                                        padding-left: 6px;
                                        alignment: center;
                                        Text {
                                            text: album.title;
                                            color: Theme.text;
                                            font-size: 13px;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: album.artist;
                                            color: Theme.muted;
                                            font-size: 11px;
                                            overflow: elide;
                                        }
                                    }
                                    TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        clicked => { root.open-album(index); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle { width: 1px; background: #333; }

            VerticalLayout {
                width: 280px;
                padding: 12px;
                spacing: 6px;
                Text {
                    text: root.queue-title;
                    color: Theme.orange;
                    font-size: 14px;
                    overflow: elide;
                }
                Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        for item in root.queue: Rectangle {
                            height: 40px;
                            background: item.current ? Theme.orange : transparent;
                            VerticalLayout {
                                padding-left: 6px;
                                alignment: center;
                                Text {
                                    text: item.number == "" ? item.title : item.number + "  " + item.title;
                                    color: item.current ? #1b1b1b : Theme.text;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                                Text {
                                    text: item.duration;
                                    color: item.current ? #3a240f : Theme.muted;
                                    font-size: 11px;
                                }
                            }
                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { root.play-row(item.source); }
                            }
                        }
                    }
                }
                Text {
                    text: root.queue-total;
                    color: Theme.dim;
                    font-size: 11px;
                    horizontal-alignment: right;
                    width: 100%;
                }
            }
        }

        Rectangle {
            height: 76px;
            background: Theme.orange;

            VerticalLayout {
                padding: 8px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 4px;
                    alignment: center;

                    IconButton { glyph: "⏮"; clicked => { root.prev(); } }
                    IconButton { glyph: root.playing ? "⏸" : "▶"; clicked => { root.play-pause(); } }
                    IconButton { glyph: "⏹"; clicked => { root.stop(); } }
                    IconButton { glyph: "⏭"; clicked => { root.next(); } }

                    Text {
                        text: root.time-label;
                        color: #1b1b1b;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    SeekBar {
                        position: root.position;
                        duration: root.duration;
                        seek(ratio) => { root.seek(ratio); }
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.duration-label;
                        color: #1b1b1b;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Text { text: "🔊"; vertical-alignment: center; }
                    VolumeBar {
                        volume: root.volume;
                        set-volume(value) => { root.set-volume(value); }
                    }
                    ModeSwitch { mode: root.mode; set-mode(mode) => { root.set-mode(mode); } }
                }

                Text {
                    text: root.status;
                    color: #3a240f;
                    font-size: 11px;
                }
            }
        }
    }
}
