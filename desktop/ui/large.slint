import { IconButton, ModeSwitch, SeekBar, Theme, VolumeBar } from "theme.slint";
import { AlbumItem, QueueItem } from "types.slint";

export component Large inherits Rectangle {
    in property <string> track-title;
    in property <string> track-artist;
    in property <string> track-album;
    in property <string> track-meta;
    in property <string> time-label;
    in property <string> duration-label;
    in property <string> status;
    in property <float> position;
    in property <float> duration;
    in property <float> volume;
    in property <bool> playing;
    in property <int> mode;
    in property <[QueueItem]> queue;
    in property <[AlbumItem]> albums;
    callback play-pause();
    callback stop();
    callback prev();
    callback next();
    callback seek(float);
    callback set-volume(float);
    callback set-mode(int);

    background: Theme.bg;

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;

            VerticalLayout {
                width: 250px;
                padding: 12px;
                spacing: 8px;
                Rectangle {
                    height: 160px;
                    background: Theme.raised;
                    Text {
                        text: "обложка";
                        color: Theme.dim;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Text { text: root.track-title; color: Theme.text; font-size: 15px; overflow: elide; wrap: word-wrap; }
                Text { text: root.track-artist; color: Theme.muted; font-size: 13px; overflow: elide; }
                Text { text: root.track-album; color: Theme.dim; font-size: 12px; overflow: elide; }
                Text { text: root.track-meta; color: Theme.dim; font-size: 11px; }
                Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        for item in root.queue: Text {
                            text: item.title;
                            color: item.current ? Theme.orange : Theme.muted;
                            font-size: 12px;
                            overflow: elide;
                            height: 20px;
                        }
                    }
                }
            }

            Rectangle { width: 1px; background: #333; }

            VerticalLayout {
                horizontal-stretch: 1;
                padding: 12px;
                spacing: 8px;
                Text { text: "Библиотека"; color: Theme.text; font-size: 14px; }
                Text { text: "альбомы подключаются на шаге 6"; color: Theme.dim; font-size: 11px; }
                HorizontalLayout {
                    spacing: 12px;
                    for album in root.albums: VerticalLayout {
                        width: 140px;
                        spacing: 4px;
                        Rectangle {
                            height: 120px;
                            background: Theme.raised;
                        }
                        Text { text: album.title; color: Theme.text; font-size: 12px; overflow: elide; }
                        Text { text: album.artist; color: Theme.muted; font-size: 11px; overflow: elide; }
                    }
                }
            }

            Rectangle { width: 1px; background: #333; }

            VerticalLayout {
                width: 280px;
                padding: 12px;
                spacing: 6px;
                Text { text: "Очередь"; color: Theme.orange; font-size: 14px; }
                Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        for item in root.queue: Rectangle {
                            height: 40px;
                            background: item.current ? Theme.orange : transparent;
                            VerticalLayout {
                                padding-left: 6px;
                                alignment: center;
                                Text {
                                    text: item.title;
                                    color: item.current ? #1b1b1b : Theme.text;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                                Text {
                                    text: item.duration;
                                    color: item.current ? #3a240f : Theme.muted;
                                    font-size: 11px;
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 76px;
            background: Theme.orange;

            VerticalLayout {
                padding: 8px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 4px;
                    alignment: center;

                    IconButton { glyph: "⏮"; clicked => { root.prev(); } }
                    IconButton { glyph: root.playing ? "⏸" : "▶"; clicked => { root.play-pause(); } }
                    IconButton { glyph: "⏹"; clicked => { root.stop(); } }
                    IconButton { glyph: "⏭"; clicked => { root.next(); } }

                    Text {
                        text: root.time-label;
                        color: #1b1b1b;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    SeekBar {
                        position: root.position;
                        duration: root.duration;
                        seek(ratio) => { root.seek(ratio); }
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.duration-label;
                        color: #1b1b1b;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Text { text: "🔊"; vertical-alignment: center; }
                    VolumeBar {
                        volume: root.volume;
                        set-volume(value) => { root.set-volume(value); }
                    }
                    ModeSwitch { mode: root.mode; set-mode(mode) => { root.set-mode(mode); } }
                }

                Text {
                    text: root.status;
                    color: #3a240f;
                    font-size: 11px;
                }
            }
        }
    }
}
