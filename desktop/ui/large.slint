import { CatalogRow, CoverArt, EmptyNote, EqButton, Glyph, Heading, QueueRow, ScrollPort, SearchField, SeekBar, Theme, TransportButton, VolumeBar } from "theme.slint";
import { AlbumItem, ArtistItem, CatalogHit, QueueItem } from "types.slint";

export component Large inherits Rectangle {
    in property <string> track-title;
    in property <string> track-artist;
    in property <string> track-album;
    in property <string> track-meta;
    in property <image> cover;
    in property <bool> has-cover;
    in property <string> time-label;
    in property <string> duration-label;
    in property <float> position;
    in property <float> duration;
    in property <float> volume;
    in property <[float]> wave;
    in property <bool> playing;
    in property <bool> eq-on;
    in property <bool> liked;
    in property <bool> disliked;
    in property <bool> album-known;
    in property <bool> album-liked;
    in property <bool> catalog-open;
    in property <string> catalog-note;
    in property <[CatalogHit]> hits;
    in property <[QueueItem]> queue;
    in property <string> queue-title;
    in property <string> queue-total;
    in property <[ArtistItem]> artists;
    in property <[AlbumItem]> albums;
    in-out property <string> search;
    callback play-pause();
    callback stop();
    callback prev();
    callback next();
    callback play-row(int);
    callback seek(float);
    callback set-volume(float);
    callback toggle-eq();
    callback toggle-like();
    callback toggle-dislike();
    callback toggle-album-like();
    callback toggle-catalog();
    callback pick-hit(int);
    callback star-album(int);
    callback search-edited(string);
    callback pick-artist(int);
    callback open-album(int);

    background: Theme.bg;

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;

            VerticalLayout {
                min-width: 200px;
                preferred-width: 230px;
                padding: 12px;
                spacing: 6px;

                CoverArt {
                    height: 148px;
                    cover: root.cover;
                    has-cover: root.has-cover;
                    mark: 72px;
                }
                Text {
                    text: root.track-title;
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 600;
                    overflow: elide;
                }
                Text { text: root.track-artist; color: Theme.muted; font-size: 13px; overflow: elide; }
                Text { text: root.track-album; color: Theme.dim; font-size: 12px; overflow: elide; }
                Text { text: root.track-meta; color: Theme.dim; font-size: 11px; overflow: elide; }
                SeekBar {
                    bar-height: 28px;
                    position: root.position;
                    duration: root.duration;
                    wave: root.wave;
                    seek(ratio) => { root.seek(ratio); }
                }

                Rectangle {
                    vertical-stretch: 1;
                    min-height: 40px;
                    preferred-height: 40px;
                    if root.queue.length == 0 : EmptyNote { message: "Нет треков"; }
                    if root.queue.length > 0 : ScrollPort {
                        for item in root.queue : Rectangle {
                            height: 24px;
                            background: row_touch.has-hover && !item.current ? Theme.raised : transparent;
                            if item.current : Rectangle {
                                x: 0px;
                                width: 2px;
                                height: 100%;
                                background: Theme.orange;
                            }
                            Text {
                                x: 8px;
                                width: parent.width - 12px;
                                height: 100%;
                                text: item.number == "" ? item.title : item.number + "  " + item.title;
                                color: item.current ? Theme.orange : Theme.muted;
                                font-size: 12px;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            row_touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                clicked => { root.play-row(item.source); }
                            }
                        }
                    }
                }
            }

            Rectangle { width: 1px; background: Theme.line; }

            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 220px;
                padding: 12px;
                spacing: 8px;

                Text {
                    text: root.catalog-open ? "Поиск" : "Библиотека";
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                }

                if root.catalog-open : Rectangle {
                    vertical-stretch: 1;
                    min-height: 40px;
                    preferred-height: 40px;
                    if root.hits.length == 0 : EmptyNote { message: "Ничего не найдено"; }
                    if root.hits.length > 0 : ScrollPort {
                        for hit[index] in root.hits : CatalogRow {
                            hit: hit;
                            clicked => { root.pick-hit(index); }
                        }
                    }
                }

                if !root.catalog-open : HorizontalLayout {
                    spacing: 8px;
                    vertical-stretch: 1;

                    VerticalLayout {
                        min-width: 120px;
                        preferred-width: 150px;
                        spacing: 4px;
                        Text { text: "Исполнители"; color: Theme.muted; font-size: 12px; }
                        Rectangle {
                            vertical-stretch: 1;
                            min-height: 40px;
                            preferred-height: 40px;
                            ScrollPort {
                                for artist[index] in root.artists : Rectangle {
                                    height: 28px;
                                    background: artist.current ? Theme.orange : (artist_touch.has-hover ? Theme.raised : transparent);
                                    Text {
                                        text: artist.name;
                                        color: artist.current ? #1b1b1b : Theme.text;
                                        font-size: 12px;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        x: 8px;
                                        width: parent.width - 16px;
                                    }
                                    artist_touch := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        mouse-cursor: pointer;
                                        clicked => { root.pick-artist(index); }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { width: 1px; background: Theme.line; }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        Text { text: "Альбомы"; color: Theme.muted; font-size: 12px; }
                        Rectangle {
                            vertical-stretch: 1;
                            min-height: 40px;
                            preferred-height: 40px;
                            if root.albums.length == 0 : EmptyNote { message: "Нет альбомов"; }
                            if root.albums.length > 0 : ScrollPort {
                                for album[index] in root.albums : Rectangle {
                                    height: 40px;
                                    background: album_touch.has-hover ? Theme.raised : transparent;
                                    HorizontalLayout {
                                        padding-right: 2px;
                                        cross-axis-alignment: center;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            VerticalLayout {
                                                padding-left: 8px;
                                                alignment: center;
                                                Text {
                                                    text: album.title;
                                                    color: album.starred ? Theme.orange : Theme.text;
                                                    font-size: 13px;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: album.artist;
                                                    color: Theme.muted;
                                                    font-size: 11px;
                                                    overflow: elide;
                                                }
                                            }
                                            album_touch := TouchArea {
                                                width: 100%;
                                                height: 100%;
                                                mouse-cursor: pointer;
                                                clicked => { root.open-album(index); }
                                            }
                                        }
                                        EqButton {
                                            label: "♥";
                                            tip: "Лайк альбома";
                                            active: album.starred;
                                            clicked => { root.star-album(index); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;
                    EqButton {
                        label: "сеть";
                        active: root.catalog-open;
                        clicked => { root.toggle-catalog(); }
                    }
                    SearchField {
                        hint: root.catalog-open ? "Поиск в сети" : "Поиск";
                        text <=> root.search;
                        edited(text) => { root.search-edited(text); }
                    }
                }
            }

            Rectangle { width: 1px; background: Theme.line; }

            VerticalLayout {
                min-width: 220px;
                preferred-width: 280px;
                padding-top: 12px;
                padding-bottom: 8px;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;

                Heading {
                    title: root.catalog-open ? root.catalog-note : root.queue-title;
                    aside: root.catalog-open ? "" : root.queue-total;
                    title-size: 14px;
                    if root.album-known && !root.catalog-open : EqButton {
                        label: "♥ альбом";
                        active: root.album-liked;
                        clicked => { root.toggle-album-like(); }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    min-height: 40px;
                    preferred-height: 40px;
                    if !root.catalog-open && root.queue.length == 0 : EmptyNote { message: "Очередь пуста"; }
                    if root.catalog-open && root.hits.length == 0 : EmptyNote { message: "Ничего не найдено"; }
                    if !root.catalog-open && root.queue.length > 0 : ScrollPort {
                        for item in root.queue : QueueRow {
                            item: item;
                            clicked => { root.play-row(item.source); }
                        }
                    }
                    if root.catalog-open && root.hits.length > 0 : ScrollPort {
                        for hit[index] in root.hits : CatalogRow {
                            hit: hit;
                            clicked => { root.pick-hit(index); }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 72px;
            background: Theme.orange;
            clip: true;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 12px;
                spacing: 10px;
                cross-axis-alignment: center;

                HorizontalLayout {
                    spacing: 0px;
                    alignment: center;
                    TransportButton { kind: "prev"; inverted: true; clicked => { root.prev(); } }
                    TransportButton { kind: "stop"; inverted: true; clicked => { root.stop(); } }
                    TransportButton {
                        kind: root.playing ? "pause" : "play";
                        primary: true;
                        clicked => { root.play-pause(); }
                    }
                    TransportButton { kind: "next"; inverted: true; clicked => { root.next(); } }
                }

                Text {
                    text: root.time-label;
                    color: #1b1b1b;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                SeekBar {
                    inverted: true;
                    bar-height: 40px;
                    position: root.position;
                    duration: root.duration;
                    wave: root.wave;
                    seek(ratio) => { root.seek(ratio); }
                }
                Text {
                    text: root.duration-label;
                    color: #1b1b1b;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                EqButton { label: "♥"; inverted: true; active: root.liked; clicked => { root.toggle-like(); } }
                EqButton { label: "нет"; inverted: true; active: root.disliked; clicked => { root.toggle-dislike(); } }
                EqButton {
                    inverted: true;
                    active: root.eq-on;
                    clicked => { root.toggle-eq(); }
                }
                Glyph { kind: "speaker"; tint: #1b1b1b; }
                VolumeBar {
                    inverted: true;
                    volume: root.volume;
                    set-volume(value) => { root.set-volume(value); }
                }
            }
        }
    }
}
