import { CatalogRow, CoverArt, EmptyNote, EqButton, Glyph, PlaybackStatus, ScrollPort, SearchField, SeekBar, Theme, TransportButton, VolumeBar } from "theme.slint";
import { AlbumDetail } from "album.slint";
import { QueueView } from "queue.slint";
import { AlbumItem, ArtistItem, CatalogHit, HomeRow, HomeSection, QueueItem } from "types.slint";

component NavigationItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 36px;
    background: root.active ? #e8872a20 : (touch.has-hover ? Theme.raised : transparent);
    border-radius: 4px;
    if root.active : Rectangle { x: 0px; width: 3px; height: 20px; y: 8px; background: Theme.orange; }
    Text {
        x: 12px;
        width: parent.width - 20px;
        height: 100%;
        text: root.label;
        color: root.active ? Theme.orange : Theme.text;
        font-size: 13px;
        font-weight: root.active ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component FeatureCard inherits Rectangle {
    in property <HomeRow> item;
    callback clicked();
    horizontal-stretch: 1;
    min-width: 160px;
    height: 132px;
    border-radius: 6px;
    background: touch.has-hover ? #38312a : Theme.panel;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.orange : Theme.line;
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HorizontalLayout {
            cross-axis-alignment: center;
            Text {
                text: root.item.kind == "wave" ? "МОЯ ВОЛНА" : "МИКС ДНЯ";
                color: Theme.orange;
                font-size: 10px;
                font-weight: 600;
                horizontal-stretch: 1;
            }
            Glyph { kind: root.item.kind == "wave" ? "play" : "next"; tint: Theme.orange; }
        }
        Text {
            text: root.item.kind == "wave" ? "Музыка под ваш вкус" : root.item.title;
            color: Theme.text;
            font-size: 15px;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            text: root.item.detail;
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
            overflow: elide;
            vertical-stretch: 1;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component HomeCard inherits Rectangle {
    in property <HomeRow> item;
    callback clicked();
    width: root.item.kind == "radio" ? 160px : 136px;
    height: root.item.kind == "radio" ? 64px : 190px;
    border-radius: 5px;
    background: touch.has-hover ? Theme.raised : transparent;
    if root.item.kind == "radio" : HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        cross-axis-alignment: center;
        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: Theme.raised;
            clip: true;
            if root.item.has-cover : Image { source: root.item.cover; width: 100%; height: 100%; image-fit: cover; }
            if !root.item.has-cover : Glyph { kind: "play"; tint: Theme.orange; x: 8px; y: 8px; }
        }
        Text { text: root.item.title; color: Theme.text; font-size: 12px; overflow: elide; horizontal-stretch: 1; }
    }
    if root.item.kind != "radio" : VerticalLayout {
        padding: 4px;
        spacing: 5px;
        CoverArt { width: 128px; height: 128px; cover: root.item.cover; has-cover: root.item.has-cover; mark: 36px; }
        Text { text: root.item.title; color: root.item.accent ? Theme.orange : Theme.text; font-size: 13px; overflow: elide; }
        Text { text: root.item.detail; color: Theme.muted; font-size: 11px; overflow: elide; }
        Rectangle { vertical-stretch: 1; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component AlbumCard inherits Rectangle {
    in property <AlbumItem> item;
    callback clicked();
    callback like();
    height: root.width + 62px;
    border-radius: 5px;
    background: touch.has-hover ? Theme.raised : transparent;
    VerticalLayout {
        padding: 4px;
        spacing: 5px;
        CoverArt { height: self.width; cover: root.item.cover; has-cover: root.item.has-cover; mark: 36px; }
        Text { text: root.item.title; color: Theme.text; font-size: 13px; overflow: elide; }
        Text { text: root.item.artist; color: Theme.muted; font-size: 11px; overflow: elide; }
        Rectangle { vertical-stretch: 1; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    EqButton {
        width: 28px;
        background: #242424e0;
        x: parent.width - self.width - 8px;
        y: 8px;
        label: "♥";
        tip: "Лайк альбома";
        active: root.item.starred;
        clicked => { root.like(); }
    }
}

export component Large inherits Rectangle {
    in property <string> track-title;
    in property <string> track-artist;
    in property <string> track-album;
    in property <string> track-meta;
    in property <image> cover;
    in property <bool> has-cover;
    in property <string> time-label;
    in property <string> duration-label;
    in property <float> position;
    in property <float> duration;
    in property <float> volume;
    in property <[float]> wave;
    in property <string> wave-message;
    in property <bool> playing;
    in property <bool> eq-on;
    in property <bool> liked;
    in property <bool> disliked;
    in property <bool> album-known;
    in property <bool> album-liked;
    in property <bool> catalog-open;
    in property <string> catalog-note;
    in property <[CatalogHit]> hits;
    in property <bool> home-open;
    in property <string> home-title;
    in property <string> home-page;
    in property <string> home-notice;
    in property <[HomeRow]> home-rows;
    in property <[HomeRow]> home-features;
    in property <[HomeSection]> home-sections;
    in property <[QueueItem]> queue;
    in property <string> queue-title;
    in property <string> queue-total;
    in property <[ArtistItem]> artists;
    in property <[AlbumItem]> albums;
    in-out property <string> search;
    in-out property <string> queue-search;
    in property <bool> queue-busy;
    in property <string> queue-error;
    in property <bool> library-busy;
    in property <string> library-error;
    in property <bool> catalog-busy;
    in property <string> playback-message;
    in property <bool> playback-busy;
    in property <bool> playback-error;
    in property <bool> seek-enabled;
    in property <bool> album-open;
    property <length> library-artists-y: 0px;
    property <length> library-albums-y: 0px;
    in property <string> album-title;
    in property <string> album-artist;
    in property <image> album-cover;
    in property <bool> album-has-cover;
    in property <[QueueItem]> album-tracks;
    in property <string> album-total;
    in property <bool> album-busy;
    in property <string> album-error;
    in property <string> album-note;
    callback queue-search-edited(string);
    callback move-queue-row(int, int);
    callback remove-queue-row(int);
    callback queue-row-next(int);
    callback close-album();
    callback album-play();
    callback album-enqueue();
    callback album-play-row(int);
    callback play-pause();
    callback stop();
    callback prev();
    callback next();
    callback play-row(int);
    callback seek(float);
    callback set-volume(float);
    callback toggle-eq();
    callback toggle-like();
    callback toggle-dislike();
    callback toggle-album-like();
    callback toggle-catalog();
    callback pick-hit(int);
    callback download-hit(int);
    callback star-album(int);
    callback search-edited(string);
    callback pick-artist(int);
    callback open-album(int);
    callback navigate(string);
    callback pick-home(int);

    background: Theme.bg;
    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;
            Rectangle {
                width: 208px;
                background: Theme.panel;
                VerticalLayout {
                    padding: 16px;
                    spacing: 4px;
                    Text { height: 24px; text: "МУЗЫКА"; color: Theme.dim; font-size: 10px; font-weight: 600; }
                    NavigationItem { label: "Главная"; active: root.home-page == "home" && !root.catalog-open; clicked => { root.navigate("home"); } }
                    NavigationItem { label: "Понравившиеся"; active: root.home-page == "liked" && !root.catalog-open; clicked => { root.navigate("liked"); } }
                    NavigationItem { label: "Плейлисты"; active: root.home-page == "playlists" && !root.catalog-open; clicked => { root.navigate("playlists"); } }
                    NavigationItem { label: "Библиотека"; active: !root.home-open && !root.catalog-open; clicked => { root.navigate("albums"); } }
                    Rectangle { vertical-stretch: 1; min-height: 12px; }
                    Text { height: 24px; text: "СЕЙЧАС ИГРАЕТ"; color: Theme.dim; font-size: 10px; font-weight: 600; }
                    CoverArt { width: 176px; height: 176px; cover: root.cover; has-cover: root.has-cover; mark: 56px; }
                    Text { height: 24px; text: root.track-title; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; vertical-alignment: center; }
                    Text { height: 18px; text: root.track-artist; color: Theme.muted; font-size: 12px; overflow: elide; }
                    Text { height: 18px; text: root.track-album; color: Theme.muted; font-size: 12px; overflow: elide; }
                    HorizontalLayout {
                        height: 28px;
                        cross-axis-alignment: center;
                        Text { text: root.track-meta; color: Theme.dim; font-size: 11px; overflow: elide; horizontal-stretch: 1; }
                        if root.album-known : EqButton { label: "♥ альбом"; active: root.album-liked; clicked => { root.toggle-album-like(); } }
                    }
                }
            }
            Rectangle { width: 1px; background: Theme.line; }
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 380px;
                padding: 16px;
                spacing: 16px;
                HorizontalLayout {
                    height: 32px;
                    spacing: 8px;
                    cross-axis-alignment: center;
                    SearchField {
                        hint: root.catalog-open ? "Найти музыку в сети" : (root.home-page == "taste" ? "Найти исполнителя" : "Поиск по библиотеке");
                        text <=> root.search;
                        edited(text) => {
                            if !root.catalog-open {
                                root.library-artists-y = 0px;
                                root.library-albums-y = 0px;
                            }
                            root.search-edited(text);
                        }
                    }
                    EqButton { label: "В сети"; tip: "Переключить поиск в сети"; active: root.catalog-open; clicked => { root.toggle-catalog(); } }
                }
                if !root.album-open : Text {
                    height: 26px;
                    text: root.catalog-open ? "Поиск в сети" : (root.home-open ? root.home-title : "Исполнители и альбомы");
                    color: Theme.text;
                    font-size: 20px;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if root.album-open : AlbumDetail {
                    album-title: root.album-title;
                    album-artist: root.album-artist;
                    album-cover: root.album-cover;
                    album-has-cover: root.album-has-cover;
                    album-tracks: root.album-tracks;
                    album-total: root.album-total;
                    album-busy: root.album-busy;
                    album-error: root.album-error;
                    album-note: root.album-note;
                    close-album => { root.close-album(); }
                    album-play => { root.album-play(); }
                    album-enqueue => { root.album-enqueue(); }
                    album-play-row(index) => { root.album-play-row(index); }
                }
                if !root.album-open && !root.catalog-open && (root.library-busy || root.library-error != "") : Rectangle {
                    vertical-stretch: 1;
                    EmptyNote { message: root.library-busy ? "Загрузка библиотеки…" : root.library-error; error: !root.library-busy; }
                }
                if !root.album-open && root.catalog-open : VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 8px;
                    Text { text: root.catalog-note; color: Theme.muted; font-size: 12px; overflow: elide; }
                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 40px;
                        if root.catalog-busy : EmptyNote { message: "Поиск в сети…"; }
                        if !root.catalog-busy && root.hits.length == 0 : EmptyNote { message: root.catalog-note; }
                        if !root.catalog-busy && root.hits.length > 0 : ScrollPort {
                            for hit[index] in root.hits : CatalogRow {
                                hit: hit;
                                clicked => { root.pick-hit(index); }
                                download => { root.download-hit(index); }
                            }
                        }
                    }
                }
                if !root.album-open && !root.library-busy && root.library-error == "" && !root.catalog-open && root.home-open && root.home-page == "home" : Rectangle {
                    vertical-stretch: 1;
                    min-height: 40px;
                    ScrollPort {
                        VerticalLayout {
                            spacing: 16px;
                            if root.home-notice != "" : Text { text: root.home-notice; color: Theme.orange; font-size: 12px; wrap: word-wrap; }
                            features := HorizontalLayout {
                                spacing: 12px;
                                for item in root.home-features : FeatureCard {
                                    width: (features.width - 12px) / 2;
                                    item: item;
                                    clicked => { root.pick-home(item.source); }
                                }
                            }
                            for section in root.home-sections : VerticalLayout {
                                spacing: 8px;
                                Text { text: section.title; color: Theme.text; font-size: 15px; font-weight: 600; }
                                Rectangle {
                                    height: section.items[0].kind == "radio" ? 68px : 198px;
                                    clip: true;
                                    Flickable {
                                        width: 100%;
                                        height: 100%;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;
                                            for item in section.items : HomeCard { item: item; clicked => { root.pick-home(item.source); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if !root.album-open && !root.library-busy && root.library-error == "" && !root.catalog-open && root.home-open && root.home-page != "home" : Rectangle {
                    vertical-stretch: 1;
                    min-height: 40px;
                    if root.home-rows.length == 0 : EmptyNote { message: "Здесь пока пусто"; }
                    ScrollPort {
                        if root.home-notice != "" : Text { text: root.home-notice; color: Theme.orange; font-size: 12px; wrap: word-wrap; }
                        for row in root.home-rows : Rectangle {
                            height: row.kind == "section" ? 36px : (row.kind == "note" ? max(32px, detail-text.preferred-height + 16px) : (row.kind == "mode" || row.kind == "taste" || row.detail != "" ? 48px : 36px));
                            background: row.accent ? #e8872a18 : (home-touch.has-hover && home-touch.enabled ? Theme.raised : transparent);
                            border-radius: 4px;
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 10px;
                                cross-axis-alignment: center;
                                if row.kind == "album" : CoverArt { width: 36px; height: 36px; cover: row.cover; has-cover: row.has-cover; mark: 20px; }
                                if row.kind == "track" : Glyph { kind: "play"; tint: Theme.orange; }
                                if row.kind == "taste" || row.kind == "mode" : Text { width: 18px; horizontal-stretch: 0; text: row.accent ? "✓" : "○"; color: row.accent ? Theme.orange : Theme.dim; font-size: 16px; }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 4px;
                                    detail-text := Text {
                                        text: row.title;
                                        color: row.accent ? Theme.orange : (row.kind == "note" || row.kind == "disabled" ? Theme.muted : Theme.text);
                                        font-size: row.kind == "section" ? 14px : 13px;
                                        font-weight: row.kind == "section" ? 600 : 400;
                                        wrap: row.kind == "note" ? word-wrap : no-wrap;
                                        overflow: elide;
                                    }
                                    if row.detail != "" : Text { text: row.detail; color: Theme.muted; font-size: 11px; overflow: elide; }
                                }
                            }
                            home-touch := TouchArea {
                                enabled: row.kind != "section" && row.kind != "note" && row.kind != "disabled";
                                mouse-cursor: pointer;
                                clicked => { root.pick-home(row.source); }
                            }
                        }
                    }
                }
                if !root.album-open && !root.library-busy && root.library-error == "" && !root.catalog-open && !root.home-open : HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 12px;
                    Rectangle {
                        width: 136px;
                        ScrollPort {
                            scroll-y <=> root.library-artists-y;
                            for artist[index] in root.artists : NavigationItem {
                                label: artist.name;
                                active: artist.current;
                                clicked => { root.library-albums-y = 0px; root.pick-artist(index); }
                            }
                        }
                    }
                    album-area := Rectangle {
                        horizontal-stretch: 1;
                        min-width: 240px;
                        property <int> columns: max(2, floor(self.width / 148px));
                        property <length> card-width: (self.width - 8px - (self.columns - 1) * 8px) / self.columns;
                        if root.albums.length == 0 : EmptyNote { message: "Нет альбомов"; }
                        ScrollPort {
                            scroll-y <=> root.library-albums-y;
                            Rectangle {
                                height: ceil(root.albums.length / album-area.columns) * (album-area.card-width + 70px);
                                for album[index] in root.albums : AlbumCard {
                                    x: mod(index, album-area.columns) * (album-area.card-width + 8px);
                                    y: floor(index / album-area.columns) * (album-area.card-width + 70px);
                                    width: album-area.card-width;
                                    item: album;
                                    clicked => { root.open-album(index); }
                                    like => { root.star-album(index); }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle { width: 1px; background: Theme.line; }
            VerticalLayout {
                width: 304px;
                padding: 12px;
                spacing: 8px;
                Text { height: 24px; text: "Очередь"; color: Theme.text; font-size: 15px; font-weight: 600; vertical-alignment: center; }
                Text { height: 20px; text: root.queue-title; color: Theme.orange; font-size: 12px; overflow: elide; }
                SearchField {
                    hint: "Фильтр очереди";
                    text <=> root.queue-search;
                    edited(text) => { root.queue-search-edited(text); }
                }
                QueueView {
                    queue: root.queue;
                    busy: root.queue-busy;
                    error: root.queue-error;
                    filtered: root.queue-search != "";
                    play-row(index) => { root.play-row(index); }
                    move-queue-row(from, to) => { root.move-queue-row(from, to); }
                    remove-queue-row(index) => { root.remove-queue-row(index); }
                    queue-row-next(index) => { root.queue-row-next(index); }
                }
                Rectangle { height: 1px; background: Theme.line; }
                Text { height: 20px; text: root.queue-total; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
            }
        }
        Rectangle {
            height: 80px;
            background: Theme.orange;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 14px;
                cross-axis-alignment: center;
                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 4px;
                    cross-axis-alignment: center;
                    TransportButton { kind: "prev"; inverted: true; clicked => { root.prev(); } }
                    TransportButton { kind: root.playing ? "pause" : "play"; primary: true; clicked => { root.play-pause(); } }
                    TransportButton { kind: "stop"; inverted: true; clicked => { root.stop(); } }
                    TransportButton { kind: "next"; inverted: true; clicked => { root.next(); } }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    SeekBar { inverted: true; bar-height: 32px; position: root.position; duration: root.duration; wave: root.wave; wave-message: root.wave-message; seek-enabled: root.seek-enabled; seek(ratio) => { root.seek(ratio); } }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: root.time-label; color: #1b1b1b; font-size: 11px; }
                        PlaybackStatus { message: root.playback-message; busy: root.playback-busy; error: root.playback-error; inverted: true; }
                        Text { text: root.duration-label; color: #1b1b1b; font-size: 11px; }
                    }
                }
                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 6px;
                    cross-axis-alignment: center;
                    EqButton { label: "♥"; inverted: true; active: root.liked; clicked => { root.toggle-like(); } }
                    EqButton { label: "нет"; inverted: true; active: root.disliked; clicked => { root.toggle-dislike(); } }
                    EqButton { inverted: true; active: root.eq-on; clicked => { root.toggle-eq(); } }
                }
                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 6px;
                    cross-axis-alignment: center;
                    Glyph { kind: "speaker"; tint: #1b1b1b; }
                    VolumeBar { volume: root.volume; inverted: true; set-volume(value) => { root.set-volume(value); } }
                }
            }
        }
    }
}
