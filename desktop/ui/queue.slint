import { TrackList, TrackMenu } from "item-menus.slint";
import { EmptyNote, Glyph, Theme, TitleButton, VerticalScrollBar } from "theme.slint";
import { QueueItem } from "types.slint";

// Observe hover before dispatch to child controls, including the drag gutter outside the Flickable.
component QueueViewport inherits TouchArea {
    Rectangle { clip: true; @children }
}

export component QueueView inherits Rectangle {
    in property <[QueueItem]> queue;
    // Index in the displayed (possibly filtered) model; -1 disables following.
    in property <int> current-row: -1;
    in property <bool> playing;
    in property <bool> quiet-actions;
    private property <length> current-top: root.current-row * root.row-height + flick.content-y;
    private property <bool> has-current: root.current-row >= 0 && root.current-row < root.queue.length && flick.height > 0px;
    private property <bool> current-offscreen: root.has-current &&
        (root.current-top + root.row-height <= 0px || root.current-top >= flick.height);
    // Publish after layout: a conditional header button must not feed back into the viewport size.
    out property <bool> show-return;
    changed current-offscreen => { root.show-return = root.current-offscreen; }
    in property <bool> busy;
    in property <string> error;
    in property <bool> filtered;
    callback play-row(int);
    callback move-queue-row(int, int);
    callback remove-queue-row(int);
    callback queue-row-next(int);
    private property <int> drag-source: -1;
    private property <bool> dragging: false;
    private property <int> target: -1;
    private property <length> row-height: 40px;
    private property <int> hovered-row: pointer.has-hover && pointer.mouse-x >= 0px &&
        pointer.mouse-x < pointer.width - 7px && pointer.mouse-y >= 0px && pointer.mouse-y < pointer.height
        ? root.row-at(pointer.mouse-y) : -1;
    private property <int> keyboard-row: -1;
    // Horizontal keyboard navigation: play the row, queue it next, or remove it.
    private property <int> keyboard-action: 0;
    vertical-stretch: 1;
    min-height: 40px;
    clip: true;

    // Keep drag handles outside the Flickable: its gesture recognizer must
    // remain free to scroll track rows, without stealing a handle drag.
    pure function row-at(y: length) -> int {
        floor((y - flick.content-y) / root.row-height)
    }
    pure function row-focused(index: int) -> bool {
        list-keys.has-focus && root.keyboard-row == index
    }
    pure function show-actions(index: int, source: int) -> bool {
        !root.quiet-actions || root.hovered-row == index || root.row-focused(index) || root.drag-source == source
    }
    function focus-row(index: int) {
        root.keyboard-row = clamp(index, 0, root.queue.length - 1);
        let top = root.keyboard-row * root.row-height;
        if top + flick.content-y < 0px {
            flick.content-y = -top;
        } else if top + flick.content-y + root.row-height > flick.height {
            flick.content-y = min(0px, flick.height - top - root.row-height);
        }
    }
    function reset-drag() {
        root.drag-source = -1;
        root.dragging = false;
        root.target = -1;
    }
    changed queue => {
        root.reset-drag();
        if list-keys.has-focus && root.keyboard-row >= root.queue.length {
            if root.queue.length > 0 { root.focus-row(root.queue.length - 1); }
            else { list-keys.clear-focus(); }
        }
    }

    public function reveal-current() {
        if root.has-current && (root.current-top < 0px || root.current-top + root.row-height > flick.height) {
            flick.content-y = -clamp(root.current-row * root.row-height - (flick.height - root.row-height) / 2,
                0px, max(0px, flick.content-height - flick.height));
        }
    }
    init => { root.reveal-current(); }
    changed current-row => { root.reveal-current(); }

    VerticalLayout {
        spacing: 2px;
        if root.queue.length > 0 && (root.busy || root.error != "") : Text {
            text: root.busy ? "Загрузка новой очереди…" : root.error;
            color: root.busy ? Theme.muted : Theme.orange;
            font-size: 11px;
            wrap: word-wrap;
        }
        pointer := QueueViewport {
            enabled: root.quiet-actions;
            vertical-stretch: 1;
            min-height: 20px;
            if root.busy && root.queue.length == 0 : EmptyNote { message: "Загрузка очереди…"; }
            if !root.busy && root.error != "" && root.queue.length == 0 : EmptyNote { message: root.error; error: true; }
            if !root.busy && root.error == "" && root.queue.length == 0 : EmptyNote {
                message: root.filtered ? "В очереди ничего не найдено" : "Очередь пуста";
            }
            flick := Flickable {
                x: 24px;
                width: parent.width - 31px;
                height: 100%;
                visible: root.queue.length > 0;
                interactive: !root.dragging;
                content-width: self.width;
                content-height: root.queue.length * root.row-height;
                changed height => { root.reveal-current(); }
                for item[index] in root.queue : Rectangle {
                    y: index * root.row-height;
                    height: root.row-height;
                    width: flick.width;
                    background: item.current ? #e8872a30 : ((root.quiet-actions
                        ? root.hovered-row == index : row-touch.has-hover) ? Theme.raised : transparent);
                    border-width: root.row-focused(index) && root.keyboard-action == 0 ? 1px : 0px;
                    border-color: Theme.orange;
                    HorizontalLayout {
                        padding-left: 3px;
                        padding-right: 2px;
                        spacing: 4px;
                        cross-axis-alignment: center;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text { text: item.title; color: item.current ? Theme.orange : Theme.text; font-size: 12px; overflow: elide; }
                            if item.meta != "" : Text { text: item.meta; color: Theme.dim; font-size: 10px; overflow: elide; }
                        }
                        if item.liked : Glyph { kind: "heart"; tint: Theme.orange; width: 13px; height: 13px; accessible-role: image; accessible-label: "В понравившихся"; }
                        Text { text: item.duration; color: Theme.muted; font-size: 10px; }
                        Rectangle { width: 48px; }
                    }
                    row-touch := TouchArea {
                        width: parent.width - 50px;
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            // A scroll or a long pointer movement is never a play action.
                            if abs(self.mouse-y - self.pressed-y) < 6px && abs(self.mouse-x - self.pressed-x) < 6px {
                                root.play-row(item.source);
                            }
                        }
                    }
                    TitleButton {
                        x: parent.width - 48px; y: 9px; width: 24px;
                        visible: root.show-actions(index, item.source);
                        border-width: root.row-focused(index) && root.keyboard-action == 1 ? 1px : 0px;
                        border-color: Theme.orange;
                        icon: "play-next"; tip: "Следующим после текущего";
                        clicked => { root.queue-row-next(item.source); }
                    }
                    TitleButton {
                        x: parent.width - 24px; y: 9px; width: 24px;
                        visible: root.show-actions(index, item.source);
                        border-width: root.row-focused(index) && root.keyboard-action == 2 ? 1px : 0px;
                        border-color: Theme.orange;
                        glyph: "×"; tip: "Убрать из очереди";
                        clicked => { root.remove-queue-row(item.source); }
                    }
                    TrackMenu {
                        list: TrackList.queue;
                        source: item.source;
                        song-id: item.song-id;
                        can-next: item.can-move-next;
                        can-end: item.can-move-end;
                    }
                }
            }
            if root.queue.length > 0 : Rectangle {
                x: 0px; y: 0px;
                width: 24px; height: 100%; clip: true;
                for item[index] in root.queue : Text {
                    y: index * root.row-height + flick.content-y;
                    height: root.row-height; width: 24px;
                    property <bool> show-state: index == root.current-row && root.drag-source != item.source &&
                        (root.quiet-actions ? !root.show-actions(index, item.source) : !(handle.has-hover && root.row-at(handle.mouse-y) == index));
                    text: self.show-state ? (root.playing ? "▶" : "Ⅱ") : (root.show-actions(index, item.source) ? "≡" : "");
                    color: self.show-state || root.drag-source == item.source ? Theme.orange : Theme.dim;
                    font-size: self.show-state ? 14px : 18px;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                handle := TouchArea {
                    mouse-cursor: grab;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            let row = root.row-at(self.mouse-y);
                            if row >= 0 && row < root.queue.length {
                                root.drag-source = root.queue[row].source;
                                root.target = row;
                            }
                        } else if event.kind == PointerEventKind.move && root.drag-source >= 0 {
                            if abs(self.mouse-y - self.pressed-y) >= 6px || abs(self.mouse-x - self.pressed-x) >= 6px {
                                root.dragging = true;
                            }
                            if root.dragging {
                                // Edge scrolling also permits dropping beyond the initial viewport.
                                if self.mouse-y < 16px { flick.content-y = min(0px, flick.content-y + 10px); }
                                if self.mouse-y > self.height - 16px { flick.content-y = max(min(0px, flick.height - flick.content-height), flick.content-y - 10px); }
                                root.target = max(0, min(root.queue.length - 1, root.row-at(self.mouse-y)));
                            }
                        } else if event.kind == PointerEventKind.up {
                            let source = root.drag-source;
                            let target = root.target;
                            let commit = root.dragging && source >= 0 && target >= 0 && target < root.queue.length && self.mouse-y >= 0px && self.mouse-y <= self.height && self.mouse-x >= 0px && self.mouse-x <= pointer.width;
                            root.reset-drag();
                            if commit { root.move-queue-row(source, root.queue[target].source); }
                        } else if event.kind == PointerEventKind.cancel { root.reset-drag(); }
                    }
                    scroll-event(event) => {
                        flick.content-y = max(min(0px, flick.height - flick.content-height), min(0px, flick.content-y + event.delta-y));
                        root.reset-drag();
                        accept
                    }
                }
                Tooltip { text: root.quiet-actions
                    ? @markdown("Перетащите за ≡ или нажмите Alt+↑/↓, чтобы изменить порядок")
                    : @markdown("Перетащите за ≡, чтобы изменить порядок"); }
            }
            if root.dragging && root.target >= 0 : Rectangle {
                x: 0px; y: root.target * root.row-height + flick.content-y;
                width: parent.width - 7px; height: root.row-height;
                border-width: 2px; border-color: Theme.orange;
                background: #e8872a12;
            }
            VerticalScrollBar {
                x: parent.width - self.width;
                y: 0px;
                height: flick.height;
                content-height: flick.content-height;
                scroll-y <=> flick.content-y;
            }
            // One tab stop for the entire list. Tab/Shift+Tab and player shortcuts bubble normally.
            list-keys := FocusScope {
                enabled: root.quiet-actions && root.queue.length > 0;
                focus-on-click: false;
                focus-gained => {
                    root.keyboard-action = 0;
                    root.focus-row(root.has-current && !root.current-offscreen
                        ? root.current-row : root.row-at(0px));
                }
                key-pressed(event) => {
                    if root.keyboard-row < 0 || root.keyboard-row >= root.queue.length ||
                        event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
                    if event.text == Key.UpArrow || event.text == Key.DownArrow {
                        let target = clamp(root.keyboard-row + (event.text == Key.UpArrow ? -1 : 1), 0, root.queue.length - 1);
                        if event.modifiers.alt && target != root.keyboard-row {
                            root.move-queue-row(root.queue[root.keyboard-row].source, root.queue[target].source);
                        }
                        root.focus-row(target);
                        return accept;
                    }
                    if event.modifiers.alt { return reject; }
                    if event.text == Key.Home || event.text == Key.End {
                        root.focus-row(event.text == Key.Home ? 0 : root.queue.length - 1);
                        return accept;
                    }
                    if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                        root.keyboard-action = clamp(root.keyboard-action + (event.text == Key.LeftArrow ? -1 : 1), 0, 2);
                        root.focus-row(root.keyboard-row);
                        return accept;
                    }
                    if event.text == Key.Return {
                        if !event.repeat {
                            root.focus-row(root.keyboard-row);
                            let source = root.queue[root.keyboard-row].source;
                            if root.keyboard-action == 0 { root.play-row(source); }
                            else if root.keyboard-action == 1 { root.queue-row-next(source); }
                            else { root.remove-queue-row(source); }
                        }
                        return accept;
                    }
                    reject
                }
            }
        }
    }
}
